-- Payload checks (Logic/Validate; docs/ARCHITECTURE.md 7.3): every action's schema, junk refused.
local T = require("../TestKit")
local Validate = require("../../build/luautest/shared/Logic/Validate")
return function()
	T.it("well-formed requests pass", function()
		T.truthy(Validate.request("plot.place", { id = "patch", x = -12, z = 20, rot = 90 }))
		T.truthy(Validate.request("island.expand", nil), "no payload is an empty one")
		T.truthy(Validate.request("folk.work", { id = 3, uid = 0 }))
		T.truthy(Validate.request("pal.work", { id = 3, uid = 12 }))
		T.truthy(Validate.request("exp.start", { site = 1, party = "" }))
		T.truthy(Validate.request("exp.start", { site = 2, party = "v3,p12,p7" }))
		T.truthy(Validate.request("exp.snack", { target = "w2" }))
		T.truthy(Validate.request("exp.flee", {}))
		T.truthy(Validate.request("exp.pause", { on = true }))
		T.truthy(Validate.request("exp.skill", { who = "v12", skill = "mend", target = "f" }))
		T.truthy(Validate.request("exp.skill", { who = "f", skill = "cry", target = "" }))
		T.truthy(Validate.request("pouch.upgrade", {}))
		T.truthy(Validate.request("founder.set", { skin = 1, hair = 2, style = 3, shirt = 8 }))
	end)
	T.it("unknown actions and junk are refused", function()
		local ok, err = Validate.request("shells.give", {})
		T.eq(ok, false)
		T.eq(err, "unknown_action")
		T.eq(select(2, Validate.request(nil, {})), "unknown_action")
		T.eq(select(2, Validate.request("exp.next", "x")), "bad_payload")
		for _, old in { "game.make", "game.launch", "micro.start", "upgrade.buy", "plot.buy", "boat.upgrade" } do
			T.eq(select(2, Validate.request(old, {})), "unknown_action", "the studio's " .. old .. " is gone")
		end
	end)
	T.it("every field is checked, missing and extra fields refused", function()
		T.eq(Validate.request("folk.work", { id = 1 }), false, "missing uid")
		T.eq(Validate.request("folk.work", { id = 1, uid = 2, x = 3 }), false, "extra field")
		T.eq(Validate.request("folk.work", { id = -1, uid = 2 }), false, "negative")
		T.eq(Validate.request("folk.work", { id = 1.5, uid = 2 }), false, "fractional")
		T.eq(Validate.request("folk.work", { id = 0 / 0, uid = 2 }), false, "NaN")
		T.eq(Validate.request("exp.start", { site = -1, party = "" }), false, "a piece uid")
		T.eq(Validate.request("exp.start", { site = 2.5, party = "" }), false, "a whole uid")
		T.eq(Validate.request("exp.start", { lvl = 1, party = "" }), false, "the slider's level")
		T.eq(Validate.request("exp.start", { isle = 1, party = "" }), false, "the sea chart's island is gone")
		T.eq(Validate.request("exp.start", { site = 1, party = "f" }), false, "the captain always goes")
		T.eq(Validate.request("exp.start", { site = 1, party = "v1,v2,v3,v4" }), false, "three members at most")
		T.eq(Validate.request("exp.start", { site = 1, party = "v1,,v2" }), false)
		T.eq(Validate.request("exp.start", { site = 1, party = ",v1" }), false)
		T.eq(Validate.request("exp.start", { site = 1, party = "x1" }), false)
		T.eq(Validate.request("exp.act", { act = "fight", target = "" }), false, "the old move is gone")
		T.eq(Validate.request("exp.snack", { target = "v1" }), false, "a snack for a wild one only")
		T.eq(Validate.request("exp.snack", { target = "" }), false, "a snack needs a wild one")
		T.eq(Validate.request("exp.pause", { on = "yes" }), false, "on or off")
		T.eq(Validate.request("exp.skill", { who = "w1", skill = "cry", target = "" }), false, "a member uses a skill")
		T.eq(Validate.request("exp.skill", { who = "f", skill = "cry", target = "x9" }), false, "a fighter to aim at")
		T.eq(Validate.request("founder.set", { skin = 1, hair = 2, style = 3, shirt = 99 }), false, "out of range")
	end)
	T.it("settings take known keys and plain values", function()
		T.truthy(Validate.request("settings.set", { k = "pixel", v = "low" }))
		T.truthy(Validate.request("settings.set", { k = "music", v = "off" }))
		T.eq(Validate.request("settings.set", { k = "shells", v = 1 }), false)
		T.eq(Validate.request("settings.set", { k = "pixel", v = {} }), false)
	end)
	T.it("drawn paths: 1 to 40 cells of whole studs in range, nothing else", function()
		T.truthy(Validate.request("plot.paint", { id = "dirtpath", cells = "0,0;2,0;-4,-6" }))
		T.truthy(Validate.request("plot.unpaint", { cells = "12,-30" }))
		local forty = {}
		for k = 1, 40 do
			table.insert(forty, k % 30 .. "," .. -k % 30)
		end
		T.truthy(Validate.request("plot.paint", { id = "dirtpath", cells = table.concat(forty, ";") }))
		table.insert(forty, "1,1")
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = table.concat(forty, ";") }), "41 cells")
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = "" }))
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = "0,0;" }))
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = "0,0;;2,2" }))
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = "99,0" }), "out of range")
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = "1.5,0" }))
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = "a,b" }))
		T.truthy(not Validate.request("plot.paint", { id = "dirtpath", cells = { "0,0" } }), "not a string")
		T.truthy(not Validate.request("plot.unpaint", { cells = "0,0", id = "dirtpath" }), "an extra field")
	end)
	T.it("plot actions: whole studs in range, quarter turns, piece indices", function()
		T.eq(Validate.request("plot.place", { id = "patch", x = 0.5, z = 20, rot = 90 }), false)
		T.eq(Validate.request("plot.place", { id = "patch", x = 100, z = 20, rot = 90 }), false)
		T.eq(Validate.request("plot.place", { id = "patch", x = 1, z = 20, rot = 45 }), false)
		T.truthy(Validate.request("plot.move", { i = 3, x = 1, z = 2, rot = 0 }))
		T.eq(Validate.request("plot.store", { i = 0 }), false)
		T.truthy(Validate.request("char.home", {}))
	end)
end
