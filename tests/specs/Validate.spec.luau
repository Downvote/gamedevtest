-- Payload checks (Logic/Validate; docs/ARCHITECTURE.md 7.3): every action's schema, junk refused.
local T = require("../TestKit")
local Validate = require("../../build/luautest/shared/Logic/Validate")
return function()
	T.it("well-formed requests pass", function()
		T.truthy(Validate.request("game.make", { a = 1, b = 2, c = 12 }))
		T.truthy(Validate.request("game.launch", nil), "no payload is an empty one")
		T.truthy(Validate.request("micro.start", { slot = 3 }))
		T.truthy(Validate.request("micro.finish", { token = 123, won = 1 }))
		T.truthy(Validate.request("upgrade.buy", { k = "luck" }))
		T.truthy(Validate.request("founder.set", { skin = 1, hair = 2, style = 3, shirt = 8 }))
	end)
	T.it("unknown actions and junk are refused", function()
		local ok, err = Validate.request("coins.give", {})
		T.eq(ok, false)
		T.eq(err, "unknown_action")
		T.eq(select(2, Validate.request(nil, {})), "unknown_action")
		T.eq(select(2, Validate.request("game.launch", "x")), "bad_payload")
		T.eq(select(2, Validate.request("project.start", {})), "unknown_action", "the old studio's actions are gone")
	end)
	T.it("every field is checked, missing and extra fields refused", function()
		T.eq(Validate.request("game.make", { a = 1, b = 2 }), false, "missing c")
		T.eq(Validate.request("game.make", { a = 1, b = 2, c = 3, d = 4 }), false, "extra field")
		T.eq(Validate.request("game.make", { a = 0, b = 2, c = 3 }), false, "index 0")
		T.eq(Validate.request("game.make", { a = 1.5, b = 2, c = 3 }), false, "fractional")
		T.eq(Validate.request("game.make", { a = 0 / 0, b = 2, c = 3 }), false, "NaN")
		T.eq(Validate.request("micro.start", { slot = 4 }), false, "slot 4")
		T.eq(Validate.request("micro.finish", { token = 1, won = 2 }), false, "won is 0 or 1")
		T.eq(Validate.request("micro.finish", { token = 1, won = true }), false, "won is a number")
		T.eq(Validate.request("micro.finish", { token = -1, won = 1 }), false, "negative token")
		T.eq(Validate.request("upgrade.buy", { k = "money" }), false, "unknown upgrade")
		T.eq(Validate.request("founder.set", { skin = 1, hair = 2, style = 3, shirt = 99 }), false, "out of range")
	end)
	T.it("settings take known keys and plain values", function()
		T.truthy(Validate.request("settings.set", { k = "pixel", v = "low" }))
		T.eq(Validate.request("settings.set", { k = "coins", v = 1 }), false)
		T.eq(Validate.request("settings.set", { k = "pixel", v = {} }), false)
	end)
	T.it("plot actions: whole studs in range, quarter turns, piece indices", function()
		T.truthy(Validate.request("plot.place", { id = "oak", x = -12, z = 20, rot = 90 }))
		T.eq(Validate.request("plot.place", { id = "oak", x = 0.5, z = 20, rot = 90 }), false)
		T.eq(Validate.request("plot.place", { id = "oak", x = 100, z = 20, rot = 90 }), false)
		T.eq(Validate.request("plot.place", { id = "oak", x = 1, z = 20, rot = 45 }), false)
		T.truthy(Validate.request("plot.move", { i = 3, x = 1, z = 2, rot = 0 }))
		T.eq(Validate.request("plot.store", { i = 0 }), false)
		T.truthy(Validate.request("plot.buy", { id = "fountain" }))
		T.truthy(Validate.request("char.home", {}))
	end)
end
