local T = require("../TestKit")
local Calendar = require("../../build/luautest/shared/Logic/Calendar")
return function()
	T.it("week 0 is Year 1, Month 1, Week 1", function()
		local y, m, w = Calendar.parts(0)
		T.eq(y, 1)
		T.eq(m, 1)
		T.eq(w, 1)
		T.eq(Calendar.label(0), "Y1 M1 W1")
	end)
	T.it("months and years roll over", function()
		T.eq(Calendar.label(3), "Y1 M1 W4")
		T.eq(Calendar.label(4), "Y1 M2 W1")
		T.eq(Calendar.label(47), "Y1 M12 W4")
		T.eq(Calendar.label(48), "Y2 M1 W1")
		T.eq(Calendar.month(47), 11)
		T.eq(Calendar.month(48), 12)
		T.eq(Calendar.year(95), 2)
		T.eq(Calendar.yearStart(3), 96)
	end)
	T.it("month starts and year ends", function()
		T.truthy(Calendar.isMonthStart(0) and Calendar.isMonthStart(4) and not Calendar.isMonthStart(5))
		T.truthy(Calendar.isYearEnd(47) and Calendar.isYearEnd(95) and not Calendar.isYearEnd(48))
	end)
end
