local T = require("../TestKit")
local Numbers = require("../../build/luautest/shared/Logic/Numbers")
return function()
	T.it("int groups thousands", function()
		T.eq(Numbers.int(0), "0")
		T.eq(Numbers.int(999), "999")
		T.eq(Numbers.int(1234), "1,234")
		T.eq(Numbers.int(1234567), "1,234,567")
		T.eq(Numbers.int(-40500), "-40,500")
	end)
	T.it("short keeps three figures", function()
		T.eq(Numbers.short(950), "950")
		T.eq(Numbers.short(9999), "9,999")
		T.eq(Numbers.short(12340), "12.3K")
		T.eq(Numbers.short(120000), "120K")
		T.eq(Numbers.short(1500000), "1.5M")
		T.eq(Numbers.short(2000000), "2M")
		T.eq(Numbers.short(3.25e9), "3.2B")
	end)
	T.it("money", function()
		T.eq(Numbers.money(40000), "$40K")
		T.eq(Numbers.money(-1200), "-$1,200")
		T.eq(Numbers.money(12345, true), "$12,345")
	end)
end
