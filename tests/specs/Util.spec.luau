local T = require("../TestKit")
local Util = require("../../build/luautest/shared/Logic/Util")
return function()
	T.it("hash32 vectors", function()
		T.eq(Util.hash32(""), 2166136261)
		T.eq(Util.hash32("a"), 0xE40C292C)
		T.eq(Util.hash32("foobar"), 0xBF9CF968)
		T.eq(Util.hash32(98), Util.hash32("98"))
	end)
	T.it("rng deterministic", function()
		local a, b = Util.newRng(42), Util.newRng(42)
		for _ = 1, 100 do T.eq(a:next(), b:next()) end
		local r = Util.newRng(0)
		T.eq(r.state, 0x9E3779B9)
	end)
	T.it("signal", function()
		local s = Util.Signal()
		local got = 0
		local c = s:Connect(function(n) got += n end)
		s:Fire(2); c:Disconnect(); s:Fire(5)
		T.eq(got, 2)
	end)
	T.it("sig2", function() T.eq(Util.sig2(1234), 1200); T.eq(Util.sig2(87), 87); T.eq(Util.sig2(1550), 1600) end)
end
