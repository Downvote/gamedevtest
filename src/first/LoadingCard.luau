------------------------------------------------------------------ helpers
local function rgb(n: number): Color3
	return Color3.fromRGB(bit32.rshift(n, 16) % 256, bit32.rshift(n, 8) % 256, n % 256)
end
-- 0xRRGGBB -> an opaque pixel as EditableImage buffers hold it (R in the low byte)
local function px(n: number): number
	local r, g, b = bit32.rshift(n, 16) % 256, bit32.rshift(n, 8) % 256, n % 256
	return r + g * 256 + b * 65536 + 0xFF000000
end

-- The game's pixel size for a screen (Render/Raster.pixelScale with Tuning.PixelScaleMin 2 and PixelScaleSides
-- 820, 1250, 1700, 2100: one more for each the short side exceeds).
local function pixelK(vp: Vector2): number
	local short = math.min(vp.X, vp.Y)
	local k = 2
	for _, s in { 820, 1250, 1700, 2100 } do
		if short > s then
			k += 1
		end
	end
	return k
end

local function viewport(): Vector2
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return vp
end

local function newImage(w: number, h: number): (EditableImage?, Content?)
	local ok, made = pcall(function(): EditableImage
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	local img: EditableImage? = if ok then made else nil
	if img == nil then
		return nil, nil
	end
	local okC, content = pcall(Content.fromObject, img)
	if not okC then
		img:Destroy()
		return nil, nil
	end
	table.insert(S.images, img)
	return img, content
end

local function imageLabel(parent: Instance, content: Content?, z: number): ImageLabel
	local im = Instance.new("ImageLabel")
	im.BackgroundTransparency = 1
	im.BorderSizePixel = 0
	im.ResampleMode = Enum.ResamplerMode.Pixelated
	if content then
		im.ImageContent = content
	end
	im.ZIndex = z
	im.Parent = parent
	return im
end

local function rect(parent: Instance, x: number, y: number, w: number, h: number, color: number, z: number, name: string?): Frame
	local f = Instance.new("Frame")
	f.Name = name or "Rect"
	f.BorderSizePixel = 0
	f.BackgroundColor3 = rgb(color)
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.ZIndex = z
	f.Parent = parent
	return f
end

-- Pixel-art dither steps, the clean patterns a hand would use: a quarter (single dots, staggered row to row), a half
-- (a checkerboard), three quarters (the quarter's gaps). Whether pixel (x, y) takes the next tone at step s (0 none,
-- 1 a quarter, 2 a half, 3 three quarters, 4 all).
local function quarter(x: number, y: number): boolean
	return (x + 2 * (y % 2)) % 4 == 0
end
local function stepOn(x: number, y: number, s: number): boolean
	if s <= 0 then
		return false
	elseif s == 1 then
		return quarter(x, y)
	elseif s == 2 then
		return (x + y) % 2 == 0
	elseif s == 3 then
		return not quarter(x + 2, y)
	end
	return true
end

-- A banded gradient over `list` at index u (0 the first tone, #list - 1 the last): flat through the first part of each
-- band, then into the next in three even steps (a quarter, a half, three quarters) over its last `zone` (default 0.45).
local function bandAt(list: { number }, u: number, x: number, y: number, zone: number?): number
	local z = zone or 0.45
	local uu = math.clamp(u, 0, #list - 1.0001)
	local i = math.floor(uu)
	local f = uu - i
	if f < 1 - z then
		return list[i + 1]
	end
	local s = math.min(3, math.floor((f - (1 - z)) / z * 3) + 1)
	return if stepOn(x, y, s) then list[i + 2] else list[i + 1]
end

-- The same at t (0..1) along the whole list.
local function band(list: { number }, t: number, x: number, y: number, zone: number?): number
	return bandAt(list, t * (#list - 1), x, y, zone)
end

------------------------------------------------------------------ the layout
local function layoutFor(W: number, H: number): Layout
	local horizon = math.floor(H * 0.46)
	local rx = math.clamp(math.floor(W * 0.3), 80, 190)
	local ry = math.max(18, math.floor(rx * 0.3))
	local tipY = H - 15
	local cy = math.max(tipY - 8 - ry - 5, horizon + ry + 6)
	local cx = math.floor(W / 2)
	local titleY = math.max(8, math.floor(horizon * 0.16))
	return {
		W = W,
		H = H,
		horizon = horizon,
		cx = cx,
		cy = cy,
		rx = rx,
		ry = ry,
		sunX = cx + math.floor(math.min(W * 0.24, rx * 1.15)),
		sunR = math.clamp(math.floor(H * 0.07), 8, 24),
		titleY = titleY,
		statusY = titleY + 22,
		barY = titleY + 35,
		barW = math.clamp(math.floor(W * 0.34), 100, 180),
		tipY = tipY,
		pathEnd = math.max(cy - ry - 8, horizon + 14),
	}
end

-- A point on the island's top: u across (-1 .. 1 from its left to right edge), v down (-1 .. 1, back to front).
local function isl(L: Layout, u: number, v: number): (number, number)
	return L.cx + math.floor(u * L.rx + 0.5), L.cy + math.floor(v * L.ry + 0.5)
end

------------------------------------------------------------------ the painting
-- The island's coast, Data/Street's way: an oval pushed in and out by four sines (an island of the first tier's
-- phases). The island is seen from the world camera's height, so a ground point (X across, Z toward us, in px) is the
-- screen point (cx + X, cy + Z * PITCH).
local AMP = { 0.09, 0.06, 0.045, 0.025 }
local FREQ = { 2, 3, 5, 7 }
local PH = { 0.6, 2.1, 0.3, 4.0 }
local PITCH = 0.5
local ANGLES = 720

-- How far out the shoreline is (ground px) at angle a.
local function shoreR(L: Layout, a: number): number
	local c, sn = math.cos(a), math.sin(a)
	local rz = L.ry / PITCH
	local w = 1
	for k = 1, #AMP do
		w += AMP[k] * math.sin(FREQ[k] * a + PH[k])
	end
	return w / math.sqrt((c / L.rx) ^ 2 + (sn / rz) ^ 2)
end

-- Rocks at the waterline: an ink outline, lit from the top left, the shadow side a tone down.
local ROCKS: { { string } } = {
	{ "..kkk..", ".kLggk.", "kLgggdk", "kgggddk", ".kkkkk." },
	{ ".kkk.", "kLgdk", "kggdk", ".kkk." },
	{ ".kk.", "kLdk", ".kk." },
}

-- A driftwood log: bleached, lit at its left end.
local LOG: { string } = { ".kkkkkk.", "kLLwwwdk", ".kkkkkk." }

-- The still scene, painted into a buffer of W x H pixels.
local function paint(L: Layout): buffer
	local W, H = L.W, L.H
	local buf = buffer.create(W * H * 4)
	local function put(x: number, y: number, c: number)
		if x >= 0 and x < W and y >= 0 and y < H then
			buffer.writeu32(buf, (y * W + x) * 4, px(c))
		end
	end
	local function row(y: number, x0: number, x1: number, c: number)
		if y < 0 or y >= H then
			return
		end
		local v = px(c)
		for x = math.max(0, x0), math.min(W - 1, x1) do
			buffer.writeu32(buf, (y * W + x) * 4, v)
		end
	end
	local rng = Random.new(1709)
	local hz = L.horizon
	local r = L.sunR
	---------------------------------------------------------------- the sky
	for y = 0, hz - 1 do
		local t = y / math.max(1, hz - 1)
		for x = 0, W - 1 do
			buffer.writeu32(buf, (y * W + x) * 4, px(band(SKY, t, x, y)))
		end
	end
	-- stars in the dark of it
	for _ = 1, math.floor(W * hz / 260) do
		local x, y = rng:NextInteger(0, W - 1), rng:NextInteger(0, math.floor(hz * 0.5))
		put(x, y, if rng:NextNumber() < 0.25 then STAR else STAR_DIM)
	end
	-- the sun going down: its disc and rim cut by the horizon, a halo round it in two steps (a half, a quarter)
	for y = hz - r - 5, hz - 1 do
		for x = L.sunX - r - 5, L.sunX + r + 5 do
			local d = math.sqrt((x - L.sunX) ^ 2 + (y - hz) ^ 2)
			if d <= r - 2 then
				put(x, y, SUN)
			elseif d <= r then
				put(x, y, SUN_RIM)
			elseif d <= r + 2 and stepOn(x, y, 2) then
				put(x, y, SUN_HALO)
			elseif d <= r + 4 and stepOn(x, y, 1) then
				put(x, y, SUN_HALO)
			end
		end
	end
	-- long low clouds: a few rounded lobes on a flat base, a tone or two darker than the sky round them, the base lit
	-- by the sun (gold near it, pink further off), thin streaks trailing off either end in dither steps
	for _, c in { { 0.24, 0.66, 0.2, 5 }, { 0.69, 0.77, 0.15, 4 }, { 0.9, 0.53, 0.08, 3 }, { 0.07, 0.86, 0.08, 3 } } do
		local y0 = math.floor(hz * c[2])
		local half = math.floor(W * c[3] / 2)
		local mid = math.floor(W * c[1])
		local body = SKY[math.max(1, math.floor(c[2] * (#SKY - 1)))]
		-- (three lobes: the middle one tallest)
		local lobes = { { -0.45, 0.5, 0.55 }, { 0.05, 0.6, 1 }, { 0.5, 0.45, 0.7 } }
		local tail = math.floor(half * 0.6)
		local tops: { [number]: number } = {}
		for x = mid - half - tail - 1, mid + half + tail + 1 do
			local top = 0
			for _, lb in lobes do
				local q = (x - (mid + lb[1] * half)) / (lb[2] * half)
				if math.abs(q) < 1 then
					top = math.max(top, c[4] * lb[3] * math.sqrt(1 - q * q))
				end
			end
			tops[x] = math.floor(top + 0.5)
		end
		-- (no lone one pixel bump or notch on the top edge)
		for x = mid - half - tail, mid + half + tail do
			local l, r2 = tops[x - 1], tops[x + 1]
			if (tops[x] > l and tops[x] > r2) or (tops[x] < l and tops[x] < r2) then
				tops[x] = math.max(l, r2)
			end
		end
		for x = mid - half - tail, mid + half + tail do
			local th = tops[x]
			local e = math.abs(x - L.sunX) / (W * 0.32)
			local under = if e < 0.55 or (e < 1 and stepOn(x, y0, 2)) then CLOUD_LIT else CLOUD_RIM
			if th >= 1 then
				for y = y0 - th, y0 - 1 do
					put(x, y, body)
				end
				put(x, y0, under)
			else
				-- (the streak: thinning toward its end)
				local f = 1 - (math.abs(x - mid) - half * 0.75) / (half * 0.25 + tail)
				if f > 0 and stepOn(x, y0, if f > 0.66 then 3 elseif f > 0.33 then 2 else 1) then
					put(x, y0, under)
				end
			end
		end
	end
	-- far islands either side: a low hill or two, a palm or two, the edge facing the sun lit
	for _, f in { { 0.13, 0.11, 7, 2 }, { 0.87, 0.08, 5, 1 }, { 0.24, 0.035, 3, 0 } } do
		local xc, hw, hmax = math.floor(W * f[1]), math.max(8, math.floor(W * f[2])), f[3]
		local tops: { [number]: number } = {}
		for x = xc - hw, xc + hw do
			local q = (x - xc) / hw
			local hill = math.sqrt(math.max(0, 1 - q * q)) * (0.78 + 0.22 * math.sin(q * 4.2 + xc * 0.37))
			local h = math.floor(hmax * hill + 0.5)
			tops[x] = hz - h
			for y = hz - h, hz - 1 do
				put(x, y, FAR)
			end
		end
		for x = xc - hw, xc + hw do
			local nb = if L.sunX > x then tops[x + 1] else tops[x - 1]
			if tops[x] < hz and (nb == nil or nb >= tops[x]) then
				put(x, tops[x], FAR_TOP)
			end
		end
		-- palms: a trunk leaning one way, a crown of fronds drooping either side
		for p = 1, f[4] do
			local lean = if p == 1 then 1 else -1
			local x = xc + math.floor(hw * (if p == 1 then -0.3 else 0.25))
			local y = tops[x] or hz
			for k = 1, 6 do
				put(x + lean * math.floor(k / 4), y - k, FAR)
			end
			-- (two fronds arching out from the top and drooping at their tips)
			local tx, ty = x + lean, y - 6
			for _, d in { { 0, 0 }, { -1, -1 }, { -2, -1 }, { -3, 0 }, { -3, 1 }, { 1, -1 }, { 2, -1 }, { 3, 0 }, { 3, 1 } } do
				put(tx + d[1], ty + d[2], FAR)
			end
		end
	end
	---------------------------------------------------------------- the sea
	-- the bands of the sea, lifted toward warm tones round the sun's path: most near the horizon, less and narrower
	-- toward us
	local stop = L.pathEnd
	local span = math.max(1, H - 1 - hz)
	local glowEnd = math.max(hz + 4, stop + 6)
	for y = hz, H - 1 do
		local u = #SEA_WARM + (y - hz) / span * (#SEA - 1)
		local tt = math.min(1, (y - hz) / math.max(1, glowEnd - hz))
		-- (a trumpet: wide along the horizon, closing quickly to the path's own width)
		local gw = r * (1.15 + 1.5 * (1 - tt) ^ 2)
		local lift = (#SEA_WARM + 0.6) * (1 - tt)
		for x = 0, W - 1 do
			local uu = u
			if lift > 0 then
				local dx = math.abs(x - L.sunX) / gw
				if dx < 1 then
					uu -= lift * (1 - dx * dx)
				end
			end
			buffer.writeu32(buf, (y * W + x) * 4, px(bandAt(SEA_LIT, uu, x, y)))
		end
	end
	-- the horizon: brightest under the sun, thinning out to either side
	for x = 0, W - 1 do
		local dx = math.abs(x - L.sunX) / math.max(1, W * 0.45)
		if dx < 0.3 then
			put(x, hz, HORIZON_HI)
		elseif dx < 0.6 then
			put(x, hz, HORIZON)
		elseif stepOn(x, hz, if dx < 0.9 then 2 else 1) then
			put(x, hz, HORIZON)
		end
	end
	-- small waves: short lighter dashes, longer and more of them nearer, none in the sun's glow
	for _ = 1, math.floor(W * (H - hz) / 240) do
		local y = hz + 2 + math.floor((H - hz - 3) * rng:NextNumber() ^ 0.8)
		local x = rng:NextInteger(0, W - 1)
		local len = 2 + math.floor((y - hz) / (H - hz) * 6) + rng:NextInteger(0, 2)
		if y > glowEnd or math.abs(x + len / 2 - L.sunX) > r * 2.6 then
			row(y, x, x + len, DASH)
		end
	end
	-- the sun's path: lines on the swell, close together near the horizon and further apart toward us, narrowing,
	-- broken where the swell rolls; pale gold near the horizon, then gold, then coral, each line's ends a tone down
	do
		local y, k = hz + 2, 0
		while y <= stop do
			local t = (y - hz) / math.max(1, stop - hz)
			local hw = r * (1.05 - 0.6 * t)
			local shift = math.floor(math.sin(k * 2.3) * 1.6 + 0.5)
			local x0, x1 = math.floor(L.sunX - hw) + shift, math.ceil(L.sunX + hw) + shift
			local core = if t < 0.3 then PATH[1] elseif t < 0.65 then PATH[2] else PATH[3]
			local edge = if t < 0.3 then PATH[2] elseif t < 0.65 then PATH[3] else PATH[4]
			for x = x0, x1 do
				-- (a break: where two slow waves along the line meet in a trough)
				local trough = math.sin(x * 0.61 + k * 1.7) + math.sin(x * 0.27 - k * 0.9) < -1.0 - 0.5 * (1 - t)
				if not trough then
					put(x, y, if x - x0 < 2 or x1 - x < 2 then edge else core)
				end
			end
			k += 1
			y += 2 + math.floor(t * 2.2)
		end
	end
	---------------------------------------------------------------- the island
	-- Inland of the shoreline the wet sand, the beach (wider in front, narrower on a small screen) and the grass; out
	-- from it the foam and the shallows, lighter near the shore, dithered into the sea.
	local cx, cy, rx, rz = L.cx, L.cy, L.rx, L.ry / PITCH
	local ks = math.clamp(rx / 160, 0.6, 1)
	local shoreAt: { number } = table.create(ANGLES + 1, 0)
	local beachAt: { number } = table.create(ANGLES + 1, 0)
	for i = 0, ANGLES do
		local a = (i / ANGLES) * math.pi * 2 - math.pi
		shoreAt[i + 1] = shoreR(L, a)
		beachAt[i + 1] = ks * (12 + 4 * math.sin(3 * a + 1.1) + 3 * math.sin(5 * a + 0.3) + 7 * math.max(0, math.sin(a)))
	end
	local function ground(x: number, y: number): (number, number, number, number)
		local X, Z = x - cx, (y - cy) / PITCH
		local a = math.atan2(Z, X)
		local i = math.clamp(math.floor((a + math.pi) / (math.pi * 2) * ANGLES + 0.5), 0, ANGLES) + 1
		return math.sqrt(X * X + Z * Z) - shoreAt[i], beachAt[i], a, Z
	end
	-- what each pixel of the island's box is: 0 sea, 1 the shallows' outer edge, 2 the shallows, 3 near the shore,
	-- 4 foam, 5 wet sand, 6 the beach, 7 grass
	local reach = 0
	for i = 1, ANGLES + 1 do
		reach = math.max(reach, shoreAt[i])
	end
	local bx0, bx1 = cx - math.ceil(reach) - 24, cx + math.ceil(reach) + 24
	local by0, by1 = math.floor(cy - (reach + 24) * PITCH), math.ceil(cy + (reach + 24) * PITCH)
	local bw = bx1 - bx0 + 1
	local kind = buffer.create(bw * (by1 - by0 + 1))
	local function kindAt(x: number, y: number): number
		if x < bx0 or x > bx1 or y < by0 or y > by1 then
			return 0
		end
		return buffer.readu8(kind, (y - by0) * bw + x - bx0)
	end
	for y = by0, by1 do
		for x = bx0, bx1 do
			local d, beach = ground(x, y)
			local k = if d <= -beach then 7 elseif d <= -3 then 6 elseif d <= 0 then 5 elseif d <= 2.5 then 4 elseif d <= 6 then 3 elseif d <= 15 then 2 elseif d <= 22 then 1 else 0
			buffer.writeu8(kind, (y - by0) * bw + x - bx0, k)
		end
	end
	local grain = Random.new(23)
	for y = by0, by1 do
		for x = bx0, bx1 do
			local k = kindAt(x, y)
			if k == 0 then
				continue
			end
			local d, beach, a, Z = ground(x, y)
			if k == 1 then
				-- the shallows' edge thinning into the sea: a half, then a quarter
				if stepOn(x, y, if d <= 18.5 then 2 else 1) then
					put(x, y, SHALLOW_OUT)
				end
			elseif k == 2 then
				-- (a broken line of surf further out, in front and behind, where it lies along the rows)
				local surf = d >= 9 and d < 10.5 and math.abs(math.sin(a)) > 0.55 and math.sin(a * 23 + 1) + math.sin(a * 9 - 0.4) > 0.5
				put(x, y, if surf then SHALLOW_LIGHT else SHALLOW)
			elseif k == 3 then
				put(x, y, if stepOn(x, y, if d <= 4 then 4 else 2) then SHALLOW_LIGHT else SHALLOW)
			elseif k == 4 then
				-- foam: white where the waves break, broken here and there
				put(x, y, if math.sin(a * 41 + 0.5) + math.sin(a * 17 - 1.2) > -1.1 then FOAM else FOAM_DIM)
			elseif k == 5 then
				-- wet sand; in front, under the dry beach, a little step down
				if Z > 0 and (kindAt(x, y - 1) == 6 or kindAt(x, y - 2) == 6) then
					put(x, y, if kindAt(x, y - 1) == 6 then CLIFF else CLIFF_DARK)
				else
					put(x, y, if grain:NextNumber() < 0.08 then WET_HI else WET)
				end
			elseif k == 6 then
				local c = SAND
				local n = grain:NextNumber()
				if n < 0.05 then
					c = SAND_GRAIN
				elseif n < 0.058 then
					c = if n < 0.054 then SHELL else SHELL_PINK
				end
				-- lit from the top left: the back of the beach a tone lighter along its edge with the grass
				if Z < 0 and d <= -beach + 1.5 and a < -0.6 then
					c = SAND_HI
				end
				put(x, y, c)
			else
				-- grass: patches darker and lighter in dither steps, its front edge a darker lip over the beach, its
				-- back left edge lit
				local X = x - cx
				local n = math.sin(X * 0.13 + Z * 0.05) + math.sin(X * 0.06 - Z * 0.11 + 1.7) + 0.6 * math.sin(X * 0.21 + Z * 0.17 + 0.4)
				local c = GRASS
				if n > 1.35 then
					c = GRASS_DARK
				elseif n > 1.0 then
					c = if stepOn(x, y, 2) then GRASS_DARK else GRASS
				elseif n < -1.45 then
					c = GRASS_LIGHT
				elseif n < -1.15 then
					c = if stepOn(x, y, 2) then GRASS_LIGHT else GRASS
				end
				if d > -beach - 1.6 then
					c = if Z > 0 then GRASS_LIP elseif X < 0 then GRASS_HI else c
				end
				put(x, y, c)
			end
		end
	end
	-- tufts and a few flowers on the grass
	for _ = 1, math.floor(rx * rz / 70) do
		local x, y = rng:NextInteger(bx0, bx1), rng:NextInteger(by0, by1)
		if kindAt(x, y) == 7 and kindAt(x, y + 1) == 7 and kindAt(x + 1, y) == 7 then
			if rng:NextNumber() < 0.15 then
				put(x, y, if rng:NextNumber() < 0.5 then FLOWER_A else FLOWER_B)
			else
				put(x, y, GRASS_TUFT)
				put(x, y - 1, GRASS_TUFT)
				put(x + 1, y, GRASS_HI)
			end
		end
	end
	-- rocks along the shore, at the waterline
	for k, a in { -2.75, -2.6, -1.9, -0.35, 0.55, 0.68, 1.25, 2.2, 2.9 } do
		local i = math.clamp(math.floor((a + math.pi) / (math.pi * 2) * ANGLES + 0.5), 0, ANGLES) + 1
		local dist = shoreAt[i] + 1
		local x, y = cx + math.floor(math.cos(a) * dist + 0.5), cy + math.floor(math.sin(a) * dist * PITCH + 0.5)
		local pat = ROCKS[(k * 2) % #ROCKS + 1]
		for ry2, line in ipairs(pat) do
			for rx2 = 1, #line do
				local ch = string.sub(line, rx2, rx2)
				if ch ~= "." then
					local c = if ch == "k" then ROCK_INK elseif ch == "L" then ROCK_LIT elseif ch == "d" then ROCK_D else ROCK_C
					put(x + rx2 - math.ceil(#line / 2), y + ry2 - #pat + 1, c)
				end
			end
		end
	end
	-- driftwood washed up on the beach, where the whole log lies on dry sand
	for _, a in { 2.35, 1.05, -2.25 } do
		local i = math.clamp(math.floor((a + math.pi) / (math.pi * 2) * ANGLES + 0.5), 0, ANGLES) + 1
		local dist = shoreAt[i] - 3 - (beachAt[i] - 3) / 2
		local x, y = cx + math.floor(math.cos(a) * dist + 0.5), cy + math.floor(math.sin(a) * dist * PITCH + 0.5)
		local fits = true
		for ry2, line in ipairs(LOG) do
			for rx2 = 1, #line do
				if string.sub(line, rx2, rx2) ~= "." and kindAt(x + rx2 - 4, y + ry2 - 2) ~= 6 then
					fits = false
				end
			end
		end
		if fits then
			for ry2, line in ipairs(LOG) do
				for rx2 = 1, #line do
					local ch = string.sub(line, rx2, rx2)
					if ch ~= "." then
						put(x + rx2 - 4, y + ry2 - 2, if ch == "k" then LOG_INK elseif ch == "L" then LOG_LIT elseif ch == "d" then LOG_D else LOG_C)
					end
				end
			end
		end
	end
	-- a trodden path from the campfire down to the jetty: a bend to the left on its way, dirt with a dithered edge,
	-- only on the grass
	local fx, fy = isl(L, 0.02, 0.1)
	local jx = cx + math.floor(rx * 0.3)
	local jy = fy
	while jy < by1 and kindAt(jx, jy) ~= 5 and kindAt(jx, jy) ~= 4 do
		jy += 1
	end
	do
		local pts = {}
		local n = math.max(12, math.floor(math.abs(jy - fy) + math.abs(jx - fx)))
		for s = 0, n do
			local t = s / n
			table.insert(pts, Vector2.new(fx + (jx - fx) * t - math.sin(t * math.pi) * 6, fy + 3 + (jy - fy - 3) * t))
		end
		for y = math.min(fy, jy) - 3, math.max(fy, jy) + 3 do
			for x = math.min(fx, jx) - 10, math.max(fx, jx) + 4 do
				if kindAt(x, y) == 7 then
					local best = math.huge
					for _, p in pts do
						-- (rows count double: the path is as wide on the ground across as along)
						best = math.min(best, (p.X - x) ^ 2 + ((p.Y - y) * 2) ^ 2)
					end
					if best <= 1.6 ^ 2 then
						put(x, y, PATH_DIRT)
					elseif best <= 2.7 ^ 2 and stepOn(x, y, 2) then
						put(x, y, PATH_DIRT_EDGE)
					end
				end
			end
		end
	end
	for y = fy - 5, fy + 5 do
		local q = (y - fy) / 5
		if q >= -1 and q <= 1 then
			local h = math.floor(13 * math.sqrt(1 - q * q) * (1 + 0.08 * math.sin(y * 1.7)) + 0.5)
			row(y, fx - h, fx + h, PLAZA)
			if y == fy + 5 or (y > fy and math.floor(13 * math.sqrt(math.max(0, 1 - ((y + 1 - fy) / 5) ^ 2))) < h - 2) then
				row(y, fx - h, fx + h, PLAZA_RIM)
			end
		end
	end
	-- a wooden jetty from the beach out over the shallows (planks across it in two tones, a dark edge each side, posts
	-- under its end)
	do
		local y0 = jy - 2
		local y1 = math.min(y0 + math.max(10, math.floor(L.ry * 0.45)), L.tipY - 6)
		for y = y0, y1 do
			local x0 = jx - 4 + math.floor((y - y0) / 2)
			row(y, x0, x0 + 7, if (y - y0) % 3 == 0 then JETTY_LO else JETTY)
			put(x0, y, JETTY_EDGE)
			put(x0 + 7, y, JETTY_EDGE)
		end
		local xe = jx - 4 + math.floor((y1 - y0) / 2)
		for _, px0 in { xe + 1, xe + 6 } do
			for y = y1 + 1, math.min(y1 + 3, L.H - 1) do
				put(px0, y, JETTY_EDGE)
			end
		end
	end
	return buf
end

------------------------------------------------------------------ the art atlas
-- the run-length codes' alphabet (gen_loading_art.py): '#' .. '~' without the backslash -> 0 .. 90
local CODE: { number } = table.create(127, 0)
do
	local k = 0
	for c = 35, 126 do
		if c ~= 92 then
			CODE[c] = k
			k += 1
		end
	end
end

-- Decodes a sequence's frames into the atlas buffer (aw px a row) at their places: each frame a run-length line of
-- symbols (0: the frame before at the same place, the first frame's "before" being its base's first frame; 1: clear;
-- 2 + i: the sequence's colour i + 1).
local function decodeSeq(buf: buffer, aw: number, q: ArtSeq, pal: { number })
	local ns = 2 + #q.pal
	local base = 91 - ns
	local own: { number } = table.create(#q.pal, 0)
	for i, gi in q.pal do
		own[i] = pal[gi]
	end
	local w = q.w
	local first = if q.base then ART.seqs[q.base] else nil
	local prevX, prevY = if first then first.at[1][1] else 0, if first then first.at[1][2] else 0
	for f, s in q.px do
		local place = q.at[f]
		local fx, fy = place[1], place[2]
		local p = 0
		local i = 1
		local n = #s
		while i <= n do
			local v = CODE[string.byte(s, i)]
			i += 1
			local run, mul = 1, 1
			while i <= n do
				local d = CODE[string.byte(s, i)]
				if d < ns then
					break
				end
				run += (d - ns + 1) * mul
				mul *= base
				i += 1
			end
			if v == 0 then
				local k, left = p, run
				while left > 0 do
					local x, y = k % w, k // w
					local len = math.min(left, w - x)
					buffer.copy(buf, ((fy + y) * aw + fx + x) * 4, buf, ((prevY + y) * aw + prevX + x) * 4, len * 4)
					k += len
					left -= len
				end
			elseif v >= 2 then
				local c = own[v - 1]
				for k = p, p + run - 1 do
					buffer.writeu32(buf, ((fy + k // w) * aw + fx + k % w) * 4, c)
				end
			end
			p += run
		end
		prevX, prevY = fx, fy
	end
end

-- Every sequence decoded (a sequence's base before it) and uploaded as one image. False when it cannot be made.
local function buildAtlas(): boolean
	local names: { string } = {}
	for name in ART.seqs do
		table.insert(names, name)
	end
	table.sort(names, function(a: string, b: string): boolean
		local qa, qb = ART.seqs[a], ART.seqs[b]
		if (qa.base == nil) ~= (qb.base == nil) then
			return qa.base == nil
		end
		return a < b
	end)
	local pal: { number } = table.create(#ART.palette, 0)
	for i, c in ART.palette do
		pal[i] = px(c)
	end
	local buf = buffer.create(ART.W * ART.H * 4)
	for _, name in names do
		local q = ART.seqs[name]
		decodeSeq(buf, ART.W, q, pal)
		local offs: { Vector2 } = table.create(#q.at)
		for i, a in q.at do
			offs[i] = Vector2.new(a[1], a[2])
		end
		S.runs[name] = { w = q.w, h = q.h, ax = q.ax, ay = q.ay, dur = q.dur, n = #q.at, offs = offs, size = Vector2.new(q.w, q.h), usize = UDim2.fromOffset(q.w, q.h) }
	end
	local img, content = newImage(ART.W, ART.H)
	if img == nil then
		return false
	end
	local ok = pcall(function()
		(img :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(ART.W, ART.H), buf)
	end)
	if not ok then
		return false
	end
	S.atlas, S.atlasContent = img, content
	return true
end

------------------------------------------------------------------ text in the pixel font
-- A line in the pixel font as one image: the under layer (the title's outline and depth, or a 1 px drop shadow) in
-- `under`, its anti-aliasing steps in `aa`, the face over them in `face`. Returns the label's image, its size and the
-- image's offset from the text block's top-left (the em box).
local function textImage(text: string, big: boolean, style: string, face: number, under: number, aa: number?): (Content?, number, number, number, number, number)
	local f = if big then PixelFont.BIG else PixelFont.SMALL
	local m = PixelFont.mask({ text }, { face = f, align = "Center" })
	local u = PixelFont.under(m, style)
	local sm = if aa then PixelFont.smooth(m, u) else u
	local x0, y0 = math.min(m.ox, sm.ox), math.min(m.oy, sm.oy)
	local x1, y1 = math.max(m.ox + m.w, sm.ox + sm.w), math.max(m.oy + m.h, sm.oy + sm.h)
	local w, h = x1 - x0, y1 - y0
	local buf = buffer.create(w * h * 4)
	local cu, ca, cf = px(under), px(aa or under), px(face)
	for y = 0, sm.h - 1 do
		for x = 0, sm.w - 1 do
			local v = buffer.readu8(sm.px, y * sm.w + x)
			if v ~= 0 then
				buffer.writeu32(buf, ((sm.oy - y0 + y) * w + sm.ox - x0 + x) * 4, if v == 2 then ca else cu)
			end
		end
	end
	for y = 0, m.h - 1 do
		for x = 0, m.w - 1 do
			if buffer.readu8(m.px, y * m.w + x) ~= 0 then
				buffer.writeu32(buf, ((m.oy - y0 + y) * w + m.ox - x0 + x) * 4, cf)
			end
		end
	end
	local img, content = newImage(w, h)
	if img == nil then
		return nil, w, h, x0, y0, m.blockW
	end
	pcall(function()
		(img :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), buf)
	end)
	return content, w, h, x0, y0, m.blockW
end

-- A line centred on the canvas at row y (the em box's top). Returns the label and the block's rect.
local function centredText(parent: Instance, L: Layout, text: string, y: number, big: boolean, style: string, face: number, under: number, aa: number?, z: number): (ImageLabel?, Rect)
	local content, w, h, ox, oy, blockW = textImage(text, big, style, face, under, aa)
	local bx = math.floor((L.W - blockW) / 2)
	local r: Rect = { x0 = bx, y0 = y, x1 = bx + blockW, y1 = y + (if big then 16 else 8) }
	if content == nil then
		return nil, r
	end
	local im = imageLabel(parent, content, z)
	im.Size = UDim2.fromOffset(w, h)
	im.Position = UDim2.fromOffset(bx + ox, y + oy)
	return im, r
end

------------------------------------------------------------------ the scene's actors
local function newActor(kind: string, run: string, x: number, y: number, z: number): Actor?
	local r = S.runs[run]
	local layer = S.layer
	if r == nil or layer == nil or S.atlasContent == nil then
		return nil
	end
	local im = imageLabel(layer, S.atlasContent, z)
	im.Size = r.usize
	im.ImageRectSize = r.size
	im.ImageRectOffset = r.offs[1]
	im.Position = UDim2.fromOffset(x - r.ax, y - r.ay)
	local a: Actor = {
		kind = kind,
		label = im,
		run = run,
		x = x,
		y = y,
		t = 0,
		frame = 1,
		x0 = x,
		x1 = x,
		dir = -1,
		speed = 0,
		wait = 0,
		leader = nil,
		gap = 0,
		left = run,
		right = run,
		baseY = y,
		phase = 0,
	}
	table.insert(S.actors, a)
	return a
end

-- Shows frame i of the actor's run at its place (only what changed is written).
local function show(a: Actor, run: string, i: number)
	local r = S.runs[run]
	if r == nil then
		return
	end
	if a.run ~= run then
		a.run = run
		a.label.Size = r.usize
		a.label.ImageRectSize = r.size
	end
	local f = (i - 1) % r.n + 1
	a.frame = f
	a.label.ImageRectOffset = r.offs[f]
	local pos = UDim2.fromOffset(math.floor(a.x + 0.5) - r.ax, math.floor(a.y + 0.5) - r.ay)
	if a.label.Position ~= pos then
		a.label.Position = pos
	end
end

-- The scene laid on the island and round it.
local function placeScene(L: Layout)
	table.clear(S.actors)
	local function zOf(y: number): number
		return 20 + math.clamp(y - L.cy + L.ry + 20, 0, 400)
	end
	local function still(run: string, u: number, v: number): Actor?
		local x, y = isl(L, u, v)
		return newActor("still", run, x, y, zOf(y))
	end
	still("palm", -0.86, -0.1)
	still("palm_b", 0.84, 0.18)
	still("hut", -0.5, -0.5)
	still("tent", 0.46, -0.55)
	still("palm", -0.12, -0.7)
	still("flowers", -0.5, 0.42)
	still("flowers", 0.3, 0.55)
	still("bush", -0.72, 0.2)
	still("bush", 0.7, -0.3)
	still("bush", 0.08, -0.62)
	still("torch", 0.22, -0.2)
	still("torch", -0.2, 0.34)
	local pool = still("pool", 0.56, 0.5)
	if pool then
		pool.kind = "blink"
	end
	local fx, fy = isl(L, 0.02, 0.1)
	local fire = newActor("fire", "fire", fx, fy, zOf(fy))
	local cheer = newActor("cheer", "cheer", fx + 18, fy - 4, zOf(fy - 4))
	if cheer then
		cheer.wait = 1.5
	end
	-- embers from the fire's flame
	local fr = S.runs.fire
	if fire and fr then
		local q = ART.seqs.fire
		local pt = q.flame or { 0, -10 }
		for k = 1, 3 do
			local e = newActor("ember", "ember", fx + pt[1], fy + pt[2], zOf(fy) + 1)
			if e then
				e.baseY, e.x0, e.phase, e.t = fy + pt[2], fx + pt[1], k * 2.1, k * 0.55
			end
		end
	end
	-- the walkers: a villager and a driftling at their heels, up and down the island
	local function walker(left: string, right: string, v: number, u0: number, u1: number, speed: number, startDir: number, follower: string?, fleft: string?, gap: number?)
		local x0, y = isl(L, u0, v)
		local x1 = isl(L, u1, v)
		local a = newActor("walk", left, if startDir < 0 then x1 else x0, y, zOf(y))
		if a == nil then
			return
		end
		a.x0, a.x1, a.dir, a.speed, a.left, a.right = x0, x1, startDir, speed, left, right
		if follower and fleft then
			local f = newActor("follow", fleft, a.x - startDir * (gap or 16), y + 2, zOf(y + 2))
			if f then
				f.leader, f.gap, f.left, f.right = a, gap or 16, fleft, follower
			end
		end
	end
	walker("walk_a", "walk_a_r", 0.3, -0.55, 0.42, 13, -1, "bun_r", "bun", 15)
	walker("walk_b", "walk_b_r", -0.3, -0.35, 0.36, 11, 1, "crab_r", "crab", 14)
	walker("gullfin", "gullfin_r", 0.6, -0.16, 0.3, 9, 1)
	-- the boat out at sea, rocking past
	local boatY = L.horizon + math.max(6, math.floor((L.cy - L.ry - L.horizon) * 0.45))
	local boat = newActor("boat", "boat", math.floor(L.W * 0.18), boatY, 12)
	if boat then
		boat.speed = 4
	end
	-- gulls over the sky
	local rng = Random.new(31)
	for k = 1, 3 do
		local y = math.floor(L.horizon * (0.42 + 0.14 * k))
		local g = newActor("gull", "gull", rng:NextInteger(0, L.W), y, 14)
		if g then
			g.baseY, g.speed, g.phase = y, (if k % 2 == 0 then -1 else 1) * (9 + k * 3), k * 1.7
		end
	end
	-- stars twinkling, crests on the waves, glints on the sun's path
	for _ = 1, math.max(6, math.floor(L.W / 60)) do
		local s = newActor("star", "star", rng:NextInteger(4, L.W - 4), rng:NextInteger(3, math.floor(L.horizon * 0.42)), 5)
		if s then
			s.phase, s.t = 2.5 + rng:NextNumber() * 4, rng:NextNumber() * 6
		end
	end
	for _ = 1, math.max(8, math.floor(L.W / 45)) do
		local c = newActor("crest", "crest", 0, 0, 6)
		if c then
			c.t = -rng:NextNumber() * 3
			c.label.Visible = false
		end
	end
	for _ = 1, 4 do
		local g = newActor("glint", "glint", L.sunX, L.horizon + 4, 7)
		if g then
			g.t = -rng:NextNumber() * 2
			g.label.Visible = false
		end
	end
end

-- Whether a point of the sea is clear of the island and its shallows.
local function openSea(L: Layout, x: number, y: number): boolean
	if y < L.horizon + 3 or y > L.H - 18 then
		return false
	end
	local X, Z = x - L.cx, (y - L.cy) / PITCH
	return math.sqrt(X * X + Z * Z) > shoreR(L, math.atan2(Z, X)) + 26
end

local crestRng = Random.new(5)
local function step(dt: number)
	local L = S.L
	if L == nil then
		return
	end
	for _, a in S.actors do
		a.t += dt
		local r = S.runs[a.run]
		if r == nil then
			continue
		end
		local k = a.kind
		if k == "still" then
			continue
		elseif k == "fire" or k == "boat" then
			if k == "boat" then
				a.x += a.speed * dt
				if a.x > L.W + 40 then
					a.x = -40
				end
			end
			show(a, a.run, math.floor(a.t / r.dur) + 1)
		elseif k == "blink" then
			local cyc = a.t % 4.2
			show(a, a.run, if cyc > 4.0 then 2 else 1)
		elseif k == "cheer" then
			-- a burst of cheering, then a rest
			local cyc = a.t % 4
			show(a, a.run, if cyc < 1.6 then math.floor(cyc / r.dur) + 1 else 1)
		elseif k == "walk" then
			if a.wait > 0 then
				a.wait -= dt
				show(a, if a.dir < 0 then a.left else a.right, 1)
			else
				a.x += a.dir * a.speed * dt
				if (a.dir > 0 and a.x >= a.x1) or (a.dir < 0 and a.x <= a.x0) then
					a.x = math.clamp(a.x, a.x0, a.x1)
					a.dir = -a.dir
					a.wait = 1.2 + crestRng:NextNumber() * 1.6
				end
				show(a, if a.dir < 0 then a.left else a.right, math.floor(a.t / r.dur) + 1)
			end
		elseif k == "follow" then
			local ld = a.leader
			if ld then
				local want = ld.x - ld.dir * a.gap
				local d = want - a.x
				if math.abs(d) > 0.5 then
					local dir = if d > 0 then 1 else -1
					a.x += dir * math.min(math.abs(d), (ld.speed + 4) * dt)
					show(a, if dir < 0 then a.left else a.right, math.floor(a.t / r.dur) + 1)
				else
					show(a, if ld.dir < 0 then a.left else a.right, 1)
				end
			end
		elseif k == "gull" then
			a.x += a.speed * dt
			if a.x > L.W + 12 then
				a.x = -12
			elseif a.x < -12 then
				a.x = L.W + 12
			end
			a.y = a.baseY + math.sin(a.t * 0.9 + a.phase) * 3
			show(a, a.run, math.floor(a.t / r.dur) + 1)
		elseif k == "star" then
			local cyc = a.t % a.phase
			show(a, a.run, if cyc < r.dur * r.n then math.floor(cyc / r.dur) + 1 else 1)
		elseif k == "crest" or k == "glint" then
			if a.t >= 0 then
				local len = r.dur * r.n
				if a.t >= len then
					a.t = -(0.4 + crestRng:NextNumber() * 2.4)
					a.label.Visible = false
				else
					if not a.label.Visible then
						-- a new spot: open sea for a crest, the sun's path for a glint
						for _ = 1, 8 do
							local x, y
							if k == "crest" then
								x, y = crestRng:NextInteger(4, L.W - 8), crestRng:NextInteger(L.horizon + 4, L.H - 20)
							else
								-- (as narrow as the path's lines at that depth)
								local stop = math.max(L.horizon + 4, L.pathEnd - 2)
								y = crestRng:NextInteger(L.horizon + 3, stop)
								local hw = math.max(2, math.floor(L.sunR * (1 - 0.6 * (y - L.horizon) / (stop - L.horizon))))
								x = L.sunX + crestRng:NextInteger(-hw, hw)
							end
							if openSea(L, x, y) then
								a.x, a.y = x, y
								break
							end
						end
						a.label.Visible = true
					end
					show(a, a.run, math.floor(a.t / r.dur) + 1)
				end
			end
		elseif k == "ember" then
			local life = 1.6
			local u = (a.t % life) / life
			a.y = a.baseY - u * 14
			a.x = a.x0 + math.sin(a.t * 2 + a.phase) * 3
			show(a, a.run, math.min(r.n, math.floor(u * r.n) + 1))
		end
	end
end

------------------------------------------------------------------ building the card
local function setBar(f: number)
	local L = S.L
	local fill = S.fill
	if L == nil or fill == nil then
		return
	end
	local inner = L.barW
	local w = math.clamp(math.floor(inner * f + 0.5), 0, inner)
	fill.Size = UDim2.fromOffset(w, 3)
	fill.Visible = w > 0
	local hi = S.fillHi
	if hi then
		hi.Size = UDim2.fromOffset(w, 1)
		hi.Visible = w > 0
	end
end

local function setStatus()
	local L, layer = S.L, S.layer
	local text = STATUS[S.phase] or STATUS.start
	if L == nil or layer == nil or S.statusShown == text then
		return
	end
	S.statusShown = text
	local old = S.statusLabel
	if old then
		old:Destroy()
	end
	if S.fallback then
		return
	end
	local im, r = centredText(layer, L, text, L.statusY, false, "shadow", C.status, C.ink, nil, 902)
	S.statusLabel = im
	-- three dots after it, lit one after another
	for k, d in S.dots do
		d.Position = UDim2.fromOffset(r.x1 + 1 + (k - 1) * 3, L.statusY + 6)
	end
end

local function setTip()
	local L, layer = S.L, S.layer
	if L == nil or layer == nil or S.fallback then
		return
	end
	local old = S.tipLabel
	if old then
		old:Destroy()
	end
	local plate = S.tipPlate
	if plate then
		plate:Destroy()
	end
	local text = TIPS[S.tipIndex]
	local im, r = centredText(layer, L, text, L.tipY + 3, false, "shadow", C.text, C.ink, nil, 902)
	S.tipLabel = im
	local p = rect(layer, r.x0 - 5, L.tipY, r.x1 - r.x0 + 10, 13, C.ink, 901, "TipPlate")
	p.BackgroundTransparency = 0.3
	S.tipPlate = p
end

-- Everything laid out from the canvas's size: the painting, the scene, the words, the bar.
local function build()
	local root, canvas = S.root, S.canvas
	if root == nil or canvas == nil then
		return
	end
	local vp = viewport()
	S.K = pixelK(vp)
	local W, H = math.max(1, math.ceil(vp.X / S.K)), math.max(1, math.ceil(vp.Y / S.K))
	local L = layoutFor(W, H)
	S.L = L
	local sc = S.scaler
	if sc then
		sc.Scale = S.K
	end
	canvas.Size = UDim2.fromOffset(W, H)
	local old = S.layer
	if old then
		old:Destroy()
	end
	table.clear(S.actors)
	S.statusLabel, S.tipLabel, S.tipPlate, S.statusShown = nil, nil, nil, ""
	local layer = Instance.new("Frame")
	layer.Name = "Scene"
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromScale(1, 1)
	layer.Parent = canvas
	S.layer = layer
	if not S.fallback then
		local img, content = newImage(W, H)
		if img then
			local buf = paint(L)
			local ok = pcall(function()
				(img :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(W, H), buf)
			end)
			if ok then
				local bg = imageLabel(layer, content, 2)
				bg.Name = "Painting"
				bg.Size = UDim2.fromOffset(W, H)
				S.painted = true
			end
		end
		if not S.painted then
			S.fallback = true
		end
	end
	if S.fallback then
		-- the plain card: the sky, the sea, a sand island
		rect(layer, 0, 0, W, L.horizon, SKY[5], 2, "Sky")
		rect(layer, 0, L.horizon, W, H - L.horizon, SEA[4], 2, "Sea")
		rect(layer, L.cx - L.rx, L.cy - math.floor(L.ry / 2), 2 * L.rx, L.ry, SAND, 3, "Island")
		rect(layer, L.cx - L.rx + 12, L.cy - math.floor(L.ry / 2) + 3, 2 * L.rx - 24, L.ry - 8, GRASS, 4, "Grass")
		local t = Instance.new("TextLabel")
		t.Name = "Title"
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, 16)
		t.Position = UDim2.fromOffset(0, L.titleY)
		t.Font = Enum.Font.Arcade
		t.TextSize = 16
		t.TextColor3 = rgb(C.accent)
		t.Text = "Driftling Isle"
		t.ZIndex = 902
		t.Parent = layer
		S.title = { x0 = 0, y0 = L.titleY, x1 = W, y1 = L.titleY + 16 }
	else
		local _, r = centredText(layer, L, "Driftling Isle", L.titleY, true, "title", C.accent, C.ink, C.title_aa, 902)
		S.title = r
		if S.atlasContent then
			placeScene(L)
		end
	end
	-- the bar in its frame of planks: ink, the frame's light top and dark foot, the track, the fill with its light top
	local bx = L.cx - math.floor(L.barW / 2)
	rect(layer, bx - 3, L.barY - 3, L.barW + 6, 9, C.ink, 900, "BarInk")
	rect(layer, bx - 2, L.barY - 2, L.barW + 4, 7, C.frame, 900, "BarFrame")
	rect(layer, bx - 2, L.barY - 2, L.barW + 4, 1, C.frame_hi, 900, "BarFrameHi")
	rect(layer, bx - 2, L.barY + 4, L.barW + 4, 1, C.frame_lo, 900, "BarFrameLo")
	rect(layer, bx, L.barY, L.barW, 3, C.plate, 901, "BarTrack")
	S.fill = rect(layer, bx, L.barY, 0, 3, C.accent, 902, "BarFill")
	S.fillHi = rect(layer, bx, L.barY, 0, 1, C.accent_hi, 903, "BarFillHi")
	setBar(S.bar)
	S.dots = {}
	for k = 1, 3 do
		table.insert(S.dots, rect(layer, 0, 0, 1, 1, C.status, 902, "Dot" .. k))
	end
	setStatus()
	setTip()
	step(0)
end

------------------------------------------------------------------ the fade and the end
local function fadeTo(a: number)
	local root = S.root
	if root == nil then
		return
	end
	for _, d in root:GetDescendants() do
		if d:IsA("ImageLabel") then
			local base = d:GetAttribute("BaseT")
			if base == nil then
				base = d.ImageTransparency
				d:SetAttribute("BaseT", base)
			end
			d.ImageTransparency = 1 - (1 - (base :: number)) * (1 - a)
		elseif d:IsA("TextLabel") then
			d.TextTransparency = a
		elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then
			local base = d:GetAttribute("BaseT")
			if base == nil then
				base = d.BackgroundTransparency
				d:SetAttribute("BaseT", base)
			end
			d.BackgroundTransparency = 1 - (1 - (base :: number)) * (1 - a)
		end
	end
	root.BackgroundTransparency = a
end

local function destroy()
	local conn = S.conn
	if conn then
		conn:Disconnect()
	end
	local rc = S.resizeConn
	if rc then
		rc:Disconnect()
	end
	local gui = S.gui
	if gui then
		gui:Destroy()
	end
	pcall(function()
		GuiService.TouchControlsEnabled = true
	end)
	for _, img in S.images do
		pcall(function()
			img:Destroy()
		end)
	end
	table.clear(S.images)
	table.clear(S.actors)
	S.up = false
	S.gui, S.root, S.canvas, S.layer = nil, nil, nil, nil
end

------------------------------------------------------------------ the API
function LoadingCard.show()
	if S.up or S.finished then
		return
	end
	local player = Players.LocalPlayer
	if player == nil then
		return
	end
	local pg = player:WaitForChild("PlayerGui", 10)
	if pg == nil then
		return
	end
	S.up = true
	S.t0 = os.clock()
	local gui = Instance.new("ScreenGui")
	gui.Name = "LoadingCard"
	gui.DisplayOrder = ORDER
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BorderSizePixel = 0
	root.BackgroundColor3 = rgb(SKY[4])
	root.Size = UDim2.fromScale(1, 1)
	root.Active = true
	root.Parent = gui
	local canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.Parent = root
	local sc = Instance.new("UIScale")
	sc.Parent = canvas
	S.gui, S.root, S.canvas, S.scaler = gui, root, canvas, sc
	gui.Parent = pg
	-- (Roblox's touch buttons are hidden while the card is up: nothing to press yet, and the jump button sat on it)
	pcall(function()
		GuiService.TouchControlsEnabled = false
	end)
	-- the atlas (EditableImages may be off: the plain card then)
	local okA, made = pcall(buildAtlas)
	if not okA or not made then
		S.fallback = not (newImage(1, 1) ~= nil)
	end
	build()
	local cam = Workspace.CurrentCamera
	if cam then
		S.resizeConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			S.resizeAt = os.clock() + 0.15
		end)
	end
	S.conn = RunService.Heartbeat:Connect(function(dt: number)
		local now = os.clock()
		if S.resizeAt > 0 and now >= S.resizeAt then
			S.resizeAt = 0
			build()
		end
		-- the bar creeps toward the phase's share, and follows the picture's own progress in the last one
		local target = if S.finished then 1 elseif S.phase == "picture" then 0.45 + 0.55 * S.progress elseif S.phase == "island" then 0.4 else 0.25
		local creep = if S.phase == "picture" or S.finished then 1 else math.min(1, (now - S.t0) / 6)
		local want = target * creep
		if want > S.bar then
			S.bar = math.min(want, S.bar + dt * (if S.finished then 2.5 else 0.6))
			setBar(S.bar)
		end
		-- the dots after the status, lit one after another
		local lit = math.floor(now * 2.5) % 4
		for k, d in S.dots do
			d.Visible = k <= lit and not S.fallback
		end
		if now - S.tipAt > TIP_SEC then
			S.tipAt = now
			if S.tipAt > S.t0 + 0.5 then
				S.tipIndex = S.tipIndex % #TIPS + 1
				setTip()
			end
		end
		if now >= S.nextTick then
			S.nextTick = now + 1 / SCENE_FPS
			S.ticks += 1
			step(math.min(0.1, 1 / SCENE_FPS))
		end
		if not S.finished and now - S.t0 > SAFETY_SEC then
			LoadingCard.finish()
		end
	end)
	S.tipAt = os.clock()
end

function LoadingCard.phase(name: string)
	if STATUS[name] and not S.finished then
		S.phase = name
		setStatus()
	end
end

function LoadingCard.progress(f: number)
	S.progress = math.clamp(f, 0, 1)
end

function LoadingCard.finish()
	if S.finished then
		return
	end
	S.finished = true
	if not S.up then
		return
	end
	task.spawn(function()
		-- the bar fills, then the card fades into the picture in a few steps
		local t0 = os.clock()
		while S.bar < 0.999 and os.clock() - t0 < 0.6 do
			task.wait()
		end
		S.fading = true
		for k = 1, FADE_STEPS do
			fadeTo(k / FADE_STEPS)
			task.wait(FADE_SEC / FADE_STEPS)
		end
		destroy()
	end)
end

function LoadingCard.state(): { [string]: any }
	local L = S.L
	return {
		up = S.up,
		phase = S.phase,
		bar = S.bar,
		finished = S.finished,
		fading = S.fading,
		painted = S.painted,
		fallback = S.fallback,
		actors = #S.actors,
		ticks = S.ticks,
		K = S.K,
		size = if L then Vector2.new(L.W, L.H) else Vector2.zero,
		title = S.title,
		island = if L then { cx = L.cx, cy = L.cy, rx = L.rx, ry = L.ry } else nil,
	}
end

return LoadingCard
