------------------------------------------------------------------ helpers
local function rgb(n: number): Color3
	return Color3.fromRGB(bit32.rshift(n, 16) % 256, bit32.rshift(n, 8) % 256, n % 256)
end
-- 0xRRGGBB -> an opaque pixel as EditableImage buffers hold it (R in the low byte)
local function px(n: number): number
	local r, g, b = bit32.rshift(n, 16) % 256, bit32.rshift(n, 8) % 256, n % 256
	return r + g * 256 + b * 65536 + 0xFF000000
end

-- The game's pixel size for a screen (Render/Raster.pixelScale with Tuning.PixelScaleMin 2 and PixelScaleSides
-- 820, 1250, 1700, 2100: one more for each the short side exceeds).
local function pixelK(vp: Vector2): number
	local short = math.min(vp.X, vp.Y)
	local k = 2
	for _, s in { 820, 1250, 1700, 2100 } do
		if short > s then
			k += 1
		end
	end
	return k
end

local function viewport(): Vector2
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return vp
end

local function newImage(w: number, h: number): (EditableImage?, Content?)
	local ok, made = pcall(function(): EditableImage
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	local img: EditableImage? = if ok then made else nil
	if img == nil then
		return nil, nil
	end
	local okC, content = pcall(Content.fromObject, img)
	if not okC then
		img:Destroy()
		return nil, nil
	end
	table.insert(S.images, img)
	return img, content
end

local function imageLabel(parent: Instance, content: Content?, z: number): ImageLabel
	local im = Instance.new("ImageLabel")
	im.BackgroundTransparency = 1
	im.BorderSizePixel = 0
	im.ResampleMode = Enum.ResamplerMode.Pixelated
	if content then
		im.ImageContent = content
	end
	im.ZIndex = z
	im.Parent = parent
	return im
end

local function rect(parent: Instance, x: number, y: number, w: number, h: number, color: number, z: number, name: string?): Frame
	local f = Instance.new("Frame")
	f.Name = name or "Rect"
	f.BorderSizePixel = 0
	f.BackgroundColor3 = rgb(color)
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.ZIndex = z
	f.Parent = parent
	return f
end

-- Pixel-art dither steps, the clean patterns a hand would use: a quarter (single dots, staggered row to row), a half
-- (a checkerboard), three quarters (the quarter's gaps). Whether pixel (x, y) takes the next tone at step s (0 none,
-- 1 a quarter, 2 a half, 3 three quarters, 4 all).
local function quarter(x: number, y: number): boolean
	return (x + 2 * (y % 2)) % 4 == 0
end
local function stepOn(x: number, y: number, s: number): boolean
	if s <= 0 then
		return false
	elseif s == 1 then
		return quarter(x, y)
	elseif s == 2 then
		return (x + y) % 2 == 0
	elseif s == 3 then
		return not quarter(x + 2, y)
	end
	return true
end

-- A banded gradient over `list` at index u (0 the first tone, #list - 1 the last): flat through the first part of each
-- band, then into the next in three even steps (a quarter, a half, three quarters) over its last `zone` (default 0.45).
local function bandAt(list: { number }, u: number, x: number, y: number, zone: number?): number
	local z = zone or 0.45
	local uu = math.clamp(u, 0, #list - 1.0001)
	local i = math.floor(uu)
	local f = uu - i
	if f < 1 - z then
		return list[i + 1]
	end
	local s = math.min(3, math.floor((f - (1 - z)) / z * 3) + 1)
	return if stepOn(x, y, s) then list[i + 2] else list[i + 1]
end

-- The same at t (0..1) along the whole list.
local function band(list: { number }, t: number, x: number, y: number, zone: number?): number
	return bandAt(list, t * (#list - 1), x, y, zone)
end

------------------------------------------------------------------ the layout
-- The island floats in the middle over the sea of clouds: its grass top an oval rx by ry round (cx, cy), its underside
-- reaching `depth` below the oval's front. The Tree of Life stands at the back in the middle when its crown clears the
-- bar there; on a short canvas (a phone held flat) it stands at the back on the left, and the island sits low enough
-- for its crown to show whole. The underside takes what room is left above the tip, up to half the island's width.
local function layoutFor(W: number, H: number): Layout
	local titleY = math.max(8, math.floor(H * 0.07))
	local barY = titleY + 35
	local tipY = H - 15
	local rx = math.clamp(math.floor(W * 0.24), 70, 160)
	local ry = math.max(16, math.floor(rx * 0.3))
	local want = math.floor(rx * 0.58)
	local roomyCy = barY + 10 + TREE_TOP + math.ceil(0.62 * ry)
	local highest = tipY - 8 - ry - want -- (the lowest top that still leaves the underside its full depth)
	local cy = if roomyCy <= highest then roomyCy else math.max(highest, TREE_TOP + 4 + math.ceil(0.3 * ry))
	local depth = math.clamp(tipY - 8 - (cy + ry), 12, want)
	local cx = math.floor(W / 2)
	local horizon = math.clamp(cy + math.floor(ry * 0.6), math.floor(H * 0.5), math.floor(H * 0.66))
	return {
		W = W,
		H = H,
		horizon = horizon,
		cx = cx,
		cy = cy,
		rx = rx,
		ry = ry,
		sunX = cx + math.floor(math.min(W * 0.33, rx * 1.4)),
		sunR = math.clamp(math.floor(H * 0.07), 8, 24),
		titleY = titleY,
		statusY = titleY + 22,
		barY = barY,
		barW = math.clamp(math.floor(W * 0.34), 100, 180),
		tipY = tipY,
		depth = depth,
	}
end

-- A point on the island's top: u across (-1 .. 1 from its left to right edge), v down (-1 .. 1, back to front).
local function isl(L: Layout, u: number, v: number): (number, number)
	return L.cx + math.floor(u * L.rx + 0.5), L.cy + math.floor(v * L.ry + 0.5)
end

------------------------------------------------------------------ the painting
-- The island's rim, Data/Street's way: an oval pushed in and out by four sines. The island is seen from the world
-- camera's height, so a ground point (X across, Z toward us, in px) is the screen point (cx + X, cy + Z * PITCH).
local AMP = { 0.06, 0.04, 0.03, 0.02 }
local FREQ = { 2, 3, 5, 7 }
local PH = { 0.6, 2.1, 0.3, 4.0 }
local PITCH = 0.5

-- How far out the rim is (ground px) at angle a.
local function rimR(L: Layout, a: number): number
	local c, sn = math.cos(a), math.sin(a)
	local rz = L.ry / PITCH
	local w = 1
	for k = 1, #AMP do
		w += AMP[k] * math.sin(FREQ[k] * a + PH[k])
	end
	return w / math.sqrt((c / L.rx) ^ 2 + (sn / rz) ^ 2)
end

-- A row of round domes along W columns: per column (1 .. W) its height, whole px. Domes of radius r0 .. r1, each k of
-- its radius tall, overlapping their neighbours by about a fifth. (The sea of clouds and the cover's bank of cloud.)
local function domes(W: number, rng: Random, r0: number, r1: number, k: number): { number }
	local out: { number } = table.create(W, 0)
	local x = -r1
	while x < W + r1 do
		local r = rng:NextInteger(r0, r1)
		local cx = x + r
		local hk = r * k
		for xx = math.max(0, math.floor(cx - r)), math.min(W - 1, math.ceil(cx + r)) do
			local u = (xx + 0.5 - cx) / r
			if u > -1 and u < 1 then
				local h = math.floor(hk * math.sqrt(1 - u * u) + 0.5)
				if h > out[xx + 1] then
					out[xx + 1] = h
				end
			end
		end
		x = cx + math.floor(r * 0.6)
	end
	return out
end

-- 0.45 of a colour plus 0.3 of the ink: its outline (the rule of 2026-11-20, "a darker version of suitable
-- neighbouring pixels")
local function inkOf(c: number): number
	local r, g, b = bit32.rshift(c, 16) % 256, bit32.rshift(c, 8) % 256, c % 256
	local ir, ig, ib = bit32.rshift(INK, 16) % 256, bit32.rshift(INK, 8) % 256, INK % 256
	return math.floor(r * 0.45 + ir * 0.3 + 0.5) * 65536 + math.floor(g * 0.45 + ig * 0.3 + 0.5) * 256 + math.floor(b * 0.45 + ib * 0.3 + 0.5)
end

-- The sky and the sea of clouds, painted into a buffer of W x H pixels.
local function paint(L: Layout): buffer
	local W, H = L.W, L.H
	local buf = buffer.create(W * H * 4)
	local function put(x: number, y: number, c: number)
		x, y = math.floor(x), math.floor(y) -- (whole pixels: a fraction writes across two pixels' bytes)
		if x >= 0 and x < W and y >= 0 and y < H then
			buffer.writeu32(buf, (y * W + x) * 4, px(c))
		end
	end
	local rng = Random.new(1709)
	local hz = L.horizon
	local r = L.sunR
	-- the sky, a dusk in dithered bands down to the sea of clouds
	for y = 0, H - 1 do
		local t = math.min(1, y / math.max(1, hz - 1))
		for x = 0, W - 1 do
			buffer.writeu32(buf, (y * W + x) * 4, px(band(SKY, t, x, y)))
		end
	end
	-- stars in the dark of it
	for _ = 1, math.floor(W * hz / 260) do
		local x, y = rng:NextInteger(0, W - 1), rng:NextInteger(0, math.floor(hz * 0.5))
		put(x, y, if rng:NextNumber() < 0.25 then STAR else STAR_DIM)
	end
	-- the sun going down into the clouds: its disc and rim, a halo round it in two steps (a half, a quarter); the
	-- clouds' far layer cuts it
	local sy = hz + 2
	for y = sy - r - 5, sy + r do
		for x = L.sunX - r - 5, L.sunX + r + 5 do
			local d = math.sqrt((x - L.sunX) ^ 2 + (y - sy) ^ 2)
			if d <= r - 2 then
				put(x, y, SUN)
			elseif d <= r then
				put(x, y, SUN_RIM)
			elseif d <= r + 2 and stepOn(x, y, 2) then
				put(x, y, SUN_HALO)
			elseif d <= r + 4 and stepOn(x, y, 1) then
				put(x, y, SUN_HALO)
			end
		end
	end
	-- far islands floating over the clouds, flat silhouettes: a low hill of a top, a palm or two on the bigger ones,
	-- a rocky underside narrowing to a point; the edge of the top facing the sun lit
	for _, f in { { 0.1, 0.07, 6, 1, -10 }, { 0.9, 0.055, 5, 1, -16 }, { 0.2, 0.025, 3, 0, -26 }, { 0.8, 0.02, 2, 0, -30 } } do
		local xc, hw, hmax = math.floor(W * f[1]), math.max(6, math.floor(W * f[2])), f[3]
		local base = hz + math.floor(f[5] * math.max(0.5, H / 360) + 0.5)
		local tops: { [number]: number } = {}
		for x = xc - hw, xc + hw do
			local q = (x - xc) / hw
			local hill = math.sqrt(math.max(0, 1 - q * q)) * (0.78 + 0.22 * math.sin(q * 4.2 + xc * 0.37))
			local h = math.floor(hmax * hill + 0.5)
			-- (the underside: down to a point, a little uneven)
			local under = math.floor(hw * 0.9 * (1 - math.abs(q)) ^ 1.3 * (0.85 + 0.15 * math.sin(x * 1.3)) + 0.5)
			tops[x] = base - h
			for y = base - h, base + under do
				put(x, y, FAR)
			end
		end
		for x = xc - hw, xc + hw do
			local nb = if L.sunX > x then tops[x + 1] else tops[x - 1]
			if nb == nil or nb >= tops[x] then
				put(x, tops[x], FAR_TOP)
			end
		end
		for p = 1, f[4] do
			local lean = if p == 1 then 1 else -1
			local x = xc + math.floor(hw * -0.3)
			local y = tops[x] or base
			for k = 1, 6 do
				put(x + lean * math.floor(k / 4), y - k, FAR)
			end
			local tx, ty = x + lean, y - 6
			for _, d in { { 0, 0 }, { -1, -1 }, { -2, -1 }, { -3, 0 }, { -3, 1 }, { 1, -1 }, { 2, -1 }, { 3, 0 }, { 3, 1 } } do
				put(tx + d[1], ty + d[2], FAR)
			end
		end
	end
	-- the sea of clouds: five layers of round billows, each lower, bigger and lighter than the one behind it, flat
	-- colour and no outline
	local u = math.max(0.5, H / 360)
	local span = H - hz
	local starts = { 0, 0.14, 0.3, 0.5, 0.72 }
	for l = 1, #CLOUDS do
		local lr = Random.new(40 + l)
		local tops = domes(W, lr, math.max(3, math.floor((6 + 4 * l) * u)), math.max(5, math.floor((12 + 7 * l) * u)), 0.45)
		local base = hz + math.floor(span * starts[l]) + math.floor(4 * u)
		local c = px(CLOUDS[l])
		for x = 0, W - 1 do
			for y = math.max(0, base - tops[x + 1]), H - 1 do
				buffer.writeu32(buf, (y * W + x) * 4, c)
			end
		end
	end
	return buf
end

-- The floating island alone, on a clear buffer: its box (x0, y0, w, h on the canvas) and its pixels. The grass top in
-- patches with a lit back edge and a darker front lip, tufts and flowers; under it the courses of stones, lit from the
-- top left (a stone's top row and, on the left, its first column lighter; on the right its last column and the ring's
-- shadow side a step darker), a 1 px outline round the whole of it a darker step of the colour inside; then, keeping
-- their own colours, vines and roots hanging from the rim, rocks hanging under the point, a few stones floating beside
-- it and a stream falling off its front edge into the air.
local function paintIsle(L: Layout): (buffer, number, number, number, number)
	local cx, cy, rx, ry, D = L.cx, L.cy, L.rx, L.ry, L.depth
	local u = math.max(0.5, L.H / 360)
	local x0, y0 = cx - rx - math.floor(28 * u) - 4, cy - ry - 6
	local w = 2 * (cx - x0) + 1
	local h = (cy + ry + D) - y0 + math.floor(40 * u) + 8
	local buf = buffer.create(w * h * 4)
	local function at(x: number, y: number): number
		if x < x0 or x >= x0 + w or y < y0 or y >= y0 + h then
			return 0
		end
		return buffer.readu32(buf, ((y - y0) * w + x - x0) * 4)
	end
	local function put(x: number, y: number, c: number)
		x, y = math.floor(x), math.floor(y)
		if x >= x0 and x < x0 + w and y >= y0 and y < y0 + h then
			buffer.writeu32(buf, ((y - y0) * w + x - x0) * 4, px(c))
		end
	end
	-- the grass top
	local rz = ry / PITCH
	local front: { [number]: number } = {} -- the lowest grass row of each column
	for y = cy - ry - 4, cy + ry + 4 do
		for x = cx - rx - 4, cx + rx + 4 do
			local X, Z = x - cx, (y - cy) / PITCH
			local a = math.atan2(Z, X)
			local d = math.sqrt(X * X + Z * Z) - rimR(L, a)
			if d <= 0 then
				local n = math.sin(X * 0.13 + Z * 0.05) + math.sin(X * 0.06 - Z * 0.11 + 1.7) + 0.6 * math.sin(X * 0.21 + Z * 0.17 + 0.4)
				local c = GRASS
				if n > 1.35 then
					c = GRASS_DARK
				elseif n > 1.0 then
					c = if stepOn(x, y, 2) then GRASS_DARK else GRASS
				elseif n < -1.45 then
					c = GRASS_LIGHT
				elseif n < -1.15 then
					c = if stepOn(x, y, 2) then GRASS_LIGHT else GRASS
				end
				-- (lit from the top left: the back left edge lighter; the front edge a darker lip over the stones)
				if d > -2.2 and Z < 0 and X < rx * 0.3 then
					c = GRASS_HI
				end
				put(x, y, c)
				front[x] = math.max(front[x] or y, y)
			end
		end
	end
	for x, y in front do
		put(x, y, GRASS_LIP)
	end
	-- tufts and a few flowers
	local rng = Random.new(1709)
	for _ = 1, math.floor(rx * rz / 70) do
		local x, y = rng:NextInteger(cx - rx, cx + rx), rng:NextInteger(cy - ry, cy + ry)
		local f = front[x]
		if f and y < f - 2 and at(x, y) ~= 0 and at(x + 1, y) ~= 0 and at(x, y - 1) ~= 0 then
			if rng:NextNumber() < 0.15 then
				put(x, y, if rng:NextNumber() < 0.5 then FLOWER_A else FLOWER_B)
			else
				put(x, y, GRASS_TUFT)
				put(x, y - 1, GRASS_TUFT)
				put(x + 1, y, GRASS_HI)
			end
		end
	end
	-- the plaza round the campfire
	local fx, fy = isl(L, 0.02, 0.1)
	local pw, ph = math.max(8, math.floor(13 * rx / 175)), math.max(3, math.floor(5 * rx / 175))
	for y = fy - ph, fy + ph do
		local q = (y - fy) / ph
		local hw = math.floor(pw * math.sqrt(math.max(0, 1 - q * q)) * (1 + 0.08 * math.sin(y * 1.7)) + 0.5)
		for x = fx - hw, fx + hw do
			put(x, y, if y >= fy + ph - 1 then PLAZA_RIM else PLAZA)
		end
	end
	-- the underside, as the game's islands are built (Models/StreetModels: an earth lip, then strata of rock, narrower
	-- as they go down): a band of soil under the grass, then rows of chunky stones of uneven widths, each row offset
	-- from the one above; the stones lit from the top left (the top row and the left column a step lighter, the foot a
	-- step darker, the right side of the island in shadow) and darker the deeper they are. The foot is ragged: the
	-- island narrows to a rounded point, every chunk of it hanging a little lower or higher than the next, and a few
	-- long chunks hang under the middle.
	local sw = math.max(5, math.floor(9 * u + 0.5)) -- a stone's usual width along the rim
	local soilH = math.max(2, math.floor(3 * u + 0.5))
	local rr = Random.new(77)
	local smax = rx * math.pi / 2 + sw
	type Row = { y0: number, y1: number, cuts: { number } }
	local rows: { Row } = {}
	do
		local acc = soilH
		while acc < D + rx do
			local hgt = rr:NextInteger(math.max(3, math.floor(5 * u)), math.max(4, math.floor(8 * u)))
			local cuts: { number } = {}
			local sx = -smax - rr:NextInteger(0, sw)
			while sx < smax + sw do
				table.insert(cuts, sx)
				sx += rr:NextInteger(math.max(4, sw - 3), sw + 5)
			end
			table.insert(rows, { y0 = acc, y1 = acc + hgt, cuts = cuts })
			acc += hgt
		end
	end
	-- which stone of a row a point along the rim (s) is in
	local function stoneOf(row: Row, sv: number): number
		local cuts = row.cuts
		local lo, hi = 1, #cuts
		while lo < hi do
			local mid = (lo + hi + 1) // 2
			if cuts[mid] <= sv then
				lo = mid
			else
				hi = mid - 1
			end
		end
		return lo
	end
	local chunkW = math.max(6, math.floor(11 * u + 0.5))
	local function sOf(x: number): number
		return rx * math.asin(math.clamp((x - cx) / rx, -1, 1))
	end
	local bottom: { [number]: number } = {}
	for x = cx - rx - 2, cx + rx + 2 do
		local top = front[x]
		if top == nil then
			continue
		end
		local dx = x - cx
		local q = math.min(1, math.abs(dx) / rx)
		local sv = sOf(x)
		-- (the foot: a rounded point, each chunk along the rim its own few px lower or higher)
		local chunk = math.floor((sv + 4096) / chunkW)
		local jag = ((chunk * 7919) % 5 - 2) * 0.035 * D
		local deep = D * (1 - q ^ 1.7) ^ 0.85 + (if q < 0.8 then jag * (1 - q / 0.8) else 0)
		local long = chunk % 4 == 1 and q < 0.32
		if long then
			deep += D * (0.18 + ((chunk * 31) % 3) * 0.06) * (1 - q / 0.32)
		end
		local foot = top + math.max(soilH + 2, math.floor(deep + 0.5))
		local shade = if dx > rx * 0.42 then 1 elseif dx < -rx * 0.55 then -1 else 0
		local ri = 1
		for y = top + 1, foot do
			local r = y - top - 1
			if r < soilH then
				put(x, y, if r == soilH - 1 then ROOT else SOIL)
				continue
			end
			while rows[ri + 1] and r >= rows[ri].y1 do
				ri += 1
			end
			local row = rows[ri]
			local j = stoneOf(row, sv)
			local jl = stoneOf(row, sOf(x - 1))
			local depthK = math.floor(3 * (r / math.max(1, D)) + 0.5)
			local col = math.clamp(1 + depthK + (if j % 3 == 0 then 1 else 0) + shade, 1, 5)
			local c
			if r == row.y0 or j ~= jl then
				c = STONE[math.min(5, col + 2)] -- the crack between two stones
			elseif r == row.y0 + 1 or (stoneOf(row, sOf(x - 2)) ~= j and dx < rx * 0.3) then
				c = STONE_LIT[col]
			elseif r == row.y1 - 1 or y == foot then
				c = STONE[math.min(5, col + 1)]
			else
				c = STONE[col]
			end
			put(x, y, c)
		end
		bottom[x] = foot + 1
	end
	-- the grass hanging over the lip in rounded tufts, a step darker as it hangs
	for x, f in front do
		local k = math.floor((sOf(x) + 4096) / 3)
		local drip = (k * 13) % 4
		if drip == 3 then
			drip = 1
		end
		for i = 1, drip do
			put(x, f + i, if i == drip then GRASS_LIP else GRASS_DARK)
		end
	end
	-- stones floating beside it, a few px from the rim, each with its lit top
	for _, fs in { { -1.12, 0.35, 3 }, { 1.1, 0.55, 2 }, { -1.05, 0.8, 2 } } do
		local sx = cx + math.floor(fs[1] * rx + 0.5)
		local sy = cy + ry + math.floor(fs[2] * D + 0.5)
		local half = math.max(1, math.floor(fs[3] * u + 0.5))
		for yy = -half, half do
			local hw = half + 1 - math.abs(yy) // 2
			for xx = sx - hw, sx + hw do
				put(xx, sy + yy, if yy == -half then STONE_LIT[2] elseif yy >= half - 0 then STONE[4] else STONE[3])
			end
		end
	end
	-- a stream falling off the front edge, right of the middle, down past the underside to a rounded end: its edges a
	-- darker blue, streaks of white running down it (outlined with the rest)
	local fallX = cx + math.floor(0.52 * rx + 0.5)
	local fallEnd: number? = nil
	do
		local x = fallX
		local f = front[x]
		local half = math.max(1, math.floor(1.5 * u + 0.5))
		if f then
			local stop = (bottom[x] or f) + math.floor(14 * u)
			for y = f, stop do
				local hw = if y >= stop - 1 then half - (y - stop + 2) else half
				for xx = x - hw, x + hw do
					local edgeCol = xx == x - hw or xx == x + hw
					put(xx, y, if edgeCol then FALL_EDGE elseif (y + xx * 3) % 7 == 0 then FALL_HI else FALL)
				end
			end
			fallEnd = stop
		end
	end
	-- the outline: every pixel of it beside a clear one takes a darker step of its own colour
	local edge: { number } = {}
	for y = y0, y0 + h - 1 do
		for x = x0, x0 + w - 1 do
			local c = at(x, y)
			if c ~= 0 and (at(x - 1, y) == 0 or at(x + 1, y) == 0 or at(x, y - 1) == 0 or at(x, y + 1) == 0) then
				table.insert(edge, (y - y0) * w + (x - x0))
			end
		end
	end
	for _, i in edge do
		local c = buffer.readu32(buf, i * 4)
		local r, g, b = c % 256, bit32.rshift(c, 8) % 256, bit32.rshift(c, 16) % 256
		buffer.writeu32(buf, i * 4, px(inkOf(r * 65536 + g * 256 + b)))
	end
	-- vines hanging from the rim over the stones (never past them), a leaf every few px on alternate sides, a leaf or a
	-- flower at the end
	for k, vdx in { -0.62, -0.31, 0.12, 0.38, 0.7 } do
		local x = cx + math.floor(vdx * rx + 0.5)
		local f, foot = front[x], bottom[x]
		if f and foot then
			local len = math.min(math.floor((10 + (k * 7) % 15) * u), foot - f - 4)
			if len >= 3 then
				for i = 1, len do
					put(x, f + i, VINE)
					if i % 3 == 0 then
						put(x + (if i % 6 == 0 then 1 else -1), f + i, VINE_LEAF)
					end
				end
				put(x, f + len + 1, if k % 2 == 0 then VINE_BLOOM else VINE_LEAF)
			end
		end
	end
	-- roots poking out of the soil near the sides, leaning in
	for _, rdx in { -0.8, 0.76 } do
		local x = cx + math.floor(rdx * rx + 0.5)
		local f, foot = front[x], bottom[x]
		if f and foot then
			for i = 1, math.min(math.floor(5 * u), foot - f - 3) do
				put(x + (if i > 2 then (if rdx < 0 then 1 else -1) else 0), f + i, ROOT)
			end
		end
	end
	-- where the stream ends, a puff of mist: round, flat, no outline, like the clouds
	if fallEnd then
		local my = fallEnd + 1
		local r0 = math.max(2, math.floor(3 * u + 0.5))
		for _, d in { { 0, 0, r0 }, { -r0, 1, r0 - 1 }, { r0, 1, r0 - 1 } } do
			local px0, py0, mr = fallX + d[1], my + d[2], d[3]
			for yy = -mr, 0 do
				for xx = -mr, mr do
					if xx * xx + yy * yy <= mr * mr + mr then
						put(px0 + xx, py0 + yy, if yy <= -mr + 1 then CLOUDS[5] else CLOUDS[4])
					end
				end
			end
		end
	end
	return buf, x0, y0, w, h
end

------------------------------------------------------------------ the art atlas
-- the run-length codes' alphabet (gen_loading_art.py): '#' .. '~' without the backslash -> 0 .. 90
local CODE: { number } = table.create(127, 0)
do
	local k = 0
	for c = 35, 126 do
		if c ~= 92 then
			CODE[c] = k
			k += 1
		end
	end
end

-- Decodes a sequence's frames into the atlas buffer (aw px a row) at their places: each frame a run-length line of
-- symbols (0: the frame before at the same place, the first frame's "before" being its base's first frame; 1: clear;
-- 2 + i: the sequence's colour i + 1).
local function decodeSeq(buf: buffer, aw: number, q: ArtSeq, pal: { number })
	local ns = 2 + #q.pal
	local base = 91 - ns
	local own: { number } = table.create(#q.pal, 0)
	for i, gi in q.pal do
		own[i] = pal[gi]
	end
	local w = q.w
	local first = if q.base then ART.seqs[q.base] else nil
	local prevX, prevY = if first then first.at[1][1] else 0, if first then first.at[1][2] else 0
	for f, s in q.px do
		local place = q.at[f]
		local fx, fy = place[1], place[2]
		local p = 0
		local i = 1
		local n = #s
		while i <= n do
			local v = CODE[string.byte(s, i)]
			i += 1
			local run, mul = 1, 1
			while i <= n do
				local d = CODE[string.byte(s, i)]
				if d < ns then
					break
				end
				run += (d - ns + 1) * mul
				mul *= base
				i += 1
			end
			if v == 0 then
				local k, left = p, run
				while left > 0 do
					local x, y = k % w, k // w
					local len = math.min(left, w - x)
					buffer.copy(buf, ((fy + y) * aw + fx + x) * 4, buf, ((prevY + y) * aw + prevX + x) * 4, len * 4)
					k += len
					left -= len
				end
			elseif v >= 2 then
				local c = own[v - 1]
				for k = p, p + run - 1 do
					buffer.writeu32(buf, ((fy + k // w) * aw + fx + k % w) * 4, c)
				end
			end
			p += run
		end
		prevX, prevY = fx, fy
	end
end

-- Every sequence decoded (a sequence's base before it) and uploaded as one image. False when it cannot be made.
local function buildAtlas(): boolean
	local names: { string } = {}
	for name in ART.seqs do
		table.insert(names, name)
	end
	table.sort(names, function(a: string, b: string): boolean
		local qa, qb = ART.seqs[a], ART.seqs[b]
		if (qa.base == nil) ~= (qb.base == nil) then
			return qa.base == nil
		end
		return a < b
	end)
	local pal: { number } = table.create(#ART.palette, 0)
	for i, c in ART.palette do
		pal[i] = px(c)
	end
	local buf = buffer.create(ART.W * ART.H * 4)
	for _, name in names do
		local q = ART.seqs[name]
		decodeSeq(buf, ART.W, q, pal)
		local offs: { Vector2 } = table.create(#q.at)
		for i, a in q.at do
			offs[i] = Vector2.new(a[1], a[2])
		end
		S.runs[name] = { w = q.w, h = q.h, ax = q.ax, ay = q.ay, dur = q.dur, n = #q.at, offs = offs, size = Vector2.new(q.w, q.h), usize = UDim2.fromOffset(q.w, q.h) }
	end
	local img, content = newImage(ART.W, ART.H)
	if img == nil then
		return false
	end
	local ok = pcall(function()
		(img :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(ART.W, ART.H), buf)
	end)
	if not ok then
		return false
	end
	S.atlas, S.atlasContent = img, content
	return true
end

------------------------------------------------------------------ text in the pixel font
-- A line in the pixel font as one image: the under layer (the title's outline and depth, or a 1 px drop shadow) in
-- `under`, its anti-aliasing steps in `aa`, the face over them in `face`. Returns the label's image, its size and the
-- image's offset from the text block's top-left (the em box).
local function textImage(text: string, big: boolean, style: string, face: number, under: number, aa: number?): (Content?, number, number, number, number, number)
	local f = if big then PixelFont.BIG else PixelFont.SMALL
	local m = PixelFont.mask({ text }, { face = f, align = "Center" })
	local u = PixelFont.under(m, style)
	local sm = if aa then PixelFont.smooth(m, u) else u
	local x0, y0 = math.min(m.ox, sm.ox), math.min(m.oy, sm.oy)
	local x1, y1 = math.max(m.ox + m.w, sm.ox + sm.w), math.max(m.oy + m.h, sm.oy + sm.h)
	local w, h = x1 - x0, y1 - y0
	local buf = buffer.create(w * h * 4)
	local cu, ca, cf = px(under), px(aa or under), px(face)
	for y = 0, sm.h - 1 do
		for x = 0, sm.w - 1 do
			local v = buffer.readu8(sm.px, y * sm.w + x)
			if v ~= 0 then
				buffer.writeu32(buf, ((sm.oy - y0 + y) * w + sm.ox - x0 + x) * 4, if v == 2 then ca else cu)
			end
		end
	end
	for y = 0, m.h - 1 do
		for x = 0, m.w - 1 do
			if buffer.readu8(m.px, y * m.w + x) ~= 0 then
				buffer.writeu32(buf, ((m.oy - y0 + y) * w + m.ox - x0 + x) * 4, cf)
			end
		end
	end
	local img, content = newImage(w, h)
	if img == nil then
		return nil, w, h, x0, y0, m.blockW
	end
	pcall(function()
		(img :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), buf)
	end)
	return content, w, h, x0, y0, m.blockW
end

-- A line centred on the canvas at row y (the em box's top). Returns the label and the block's rect.
local function centredText(parent: Instance, L: Layout, text: string, y: number, big: boolean, style: string, face: number, under: number, aa: number?, z: number): (ImageLabel?, Rect)
	local content, w, h, ox, oy, blockW = textImage(text, big, style, face, under, aa)
	local bx = math.floor((L.W - blockW) / 2)
	local r: Rect = { x0 = bx, y0 = y, x1 = bx + blockW, y1 = y + (if big then 16 else 8) }
	if content == nil then
		return nil, r
	end
	local im = imageLabel(parent, content, z)
	im.Size = UDim2.fromOffset(w, h)
	im.Position = UDim2.fromOffset(bx + ox, y + oy)
	return im, r
end

------------------------------------------------------------------ the scene's actors
local function newActor(kind: string, run: string, x: number, y: number, z: number): Actor?
	local r = S.runs[run]
	local layer = S.layer
	if r == nil or layer == nil or S.atlasContent == nil then
		return nil
	end
	local im = imageLabel(layer, S.atlasContent, z)
	im.Size = r.usize
	im.ImageRectSize = r.size
	im.ImageRectOffset = r.offs[1]
	im.Position = UDim2.fromOffset(x - r.ax, y - r.ay)
	local a: Actor = {
		kind = kind,
		label = im,
		run = run,
		x = x,
		y = y,
		t = 0,
		frame = 1,
		x0 = x,
		x1 = x,
		dir = -1,
		speed = 0,
		wait = 0,
		leader = nil,
		gap = 0,
		left = run,
		right = run,
		baseY = y,
		phase = 0,
	}
	table.insert(S.actors, a)
	return a
end

-- Shows frame i of the actor's run at its place (only what changed is written).
local function show(a: Actor, run: string, i: number)
	local r = S.runs[run]
	if r == nil then
		return
	end
	if a.run ~= run then
		a.run = run
		a.label.Size = r.usize
		a.label.ImageRectSize = r.size
	end
	local f = (i - 1) % r.n + 1
	a.frame = f
	a.label.ImageRectOffset = r.offs[f]
	local pos = UDim2.fromOffset(math.floor(a.x + 0.5) - r.ax, math.floor(a.y + 0.5) - r.ay + (if a.isle then S.bob else 0))
	if a.label.Position ~= pos then
		a.label.Position = pos
	end
end

-- The scene laid on the island and round it.
local function placeScene(L: Layout)
	table.clear(S.actors)
	local function zOf(y: number): number
		return 20 + math.clamp(y - L.cy + L.ry + 20, 0, 400)
	end
	local function still(run: string, u: number, v: number): Actor?
		local x, y = isl(L, u, v)
		local a = newActor("still", run, x, y, zOf(y))
		if a then
			a.isle = true
		end
		return a
	end
	-- the Tree of Life at the back in the middle, rising over the sea; on a short canvas (a phone held flat) its crown
	-- would reach the bar there, so it stands at the back on the left and the hut takes the middle
	local _, backY = isl(L, 0, -0.62)
	local roomy = backY - TREE_TOP >= L.barY + 10
	local treeU, treeV = if roomy then 0 else -0.68, if roomy then -0.62 else -0.3
	if roomy then
		still("palm", -0.86, -0.1)
		still("nest", -0.52, -0.42)
	else
		still("nest", 0.02, -0.62)
	end
	still("palm_b", 0.84, 0.18)
	still("burrow", 0.5, -0.45)
	still("flowers", -0.5, 0.42)
	still("flowers", 0.3, 0.55)
	still("bush", -0.72, 0.2)
	still("bush", 0.7, -0.3)
	still("bush", 0.62, 0.42)
	still("torch", 0.24, -0.3)
	still("torch", -0.24, -0.3)
	local treeActor = still("tree", treeU, treeV)
	if treeActor then
		treeActor.kind = "blink"
	end
	local fx, fy = isl(L, 0.02, 0.1)
	local fire = newActor("fire", "fire", fx, fy, zOf(fy))
	local cheer = newActor("cheer", "cheer", fx + 18, fy - 4, zOf(fy - 4))
	if fire then
		fire.isle = true
	end
	if cheer then
		cheer.wait, cheer.isle = 1.5, true
	end
	-- embers from the fire's flame
	local fr = S.runs.fire
	if fire and fr then
		local q = ART.seqs.fire
		local pt = q.flame or { 0, -10 }
		for k = 1, 3 do
			local e = newActor("ember", "ember", fx + pt[1], fy + pt[2], zOf(fy) + 1)
			if e then
				e.baseY, e.x0, e.phase, e.t, e.isle = fy + pt[2], fx + pt[1], k * 2.1, k * 0.55, true
			end
		end
	end
	-- the walkers: a driftling and another at its heels, up and down the island
	local function walker(left: string, right: string, v: number, u0: number, u1: number, speed: number, startDir: number, follower: string?, fleft: string?, gap: number?)
		local x0, y = isl(L, u0, v)
		local x1 = isl(L, u1, v)
		local a = newActor("walk", left, if startDir < 0 then x1 else x0, y, zOf(y))
		if a == nil then
			return
		end
		a.x0, a.x1, a.dir, a.speed, a.left, a.right, a.isle = x0, x1, startDir, speed, left, right, true
		if follower and fleft then
			local f = newActor("follow", fleft, a.x - startDir * (gap or 16), y + 2, zOf(y + 2))
			if f then
				f.leader, f.gap, f.left, f.right, f.isle = a, gap or 16, fleft, follower, true
			end
		end
	end
	walker("frond", "frond_r", 0.3, -0.55, 0.42, 12, -1, "bun_r", "bun", 15)
	walker("pebble", "pebble_r", -0.12, -0.35, 0.36, 9, 1, "crab_r", "crab", 14)
	walker("gullfin", "gullfin_r", 0.6, -0.16, 0.3, 9, 1)
	-- gulls over the sky
	local rng = Random.new(31)
	for k = 1, 3 do
		local y = math.floor(L.horizon * (0.42 + 0.14 * k))
		local g = newActor("gull", "gull", rng:NextInteger(0, L.W), y, 14)
		if g then
			g.baseY, g.speed, g.phase = y, (if k % 2 == 0 then -1 else 1) * (9 + k * 3), k * 1.7
		end
	end
	-- stars twinkling
	for _ = 1, math.max(6, math.floor(L.W / 60)) do
		local s = newActor("star", "star", rng:NextInteger(4, L.W - 4), rng:NextInteger(3, math.floor(L.horizon * 0.42)), 5)
		if s then
			s.phase, s.t = 2.5 + rng:NextNumber() * 4, rng:NextNumber() * 6
		end
	end

end

local walkRng = Random.new(5)
local function step(dt: number)
	local L = S.L
	if L == nil then
		return
	end
	-- the island bobs a pixel up and down, slowly, with everything on it
	S.bobT += dt
	local v = math.sin(S.bobT * math.pi * 2 / BOB_SEC)
	local b = if v > 0.5 then -1 elseif v < -0.5 then 1 else 0
	if b ~= S.bob then
		S.bob, S.bobMoves = b, S.bobMoves + 1
		local isle = S.isleLabel
		if isle then
			isle.Position = UDim2.fromOffset(S.isleX, S.isleY + b)
		end
		for _, a in S.actors do
			if a.isle then
				show(a, a.run, a.frame)
			end
		end
	end
	for _, a in S.actors do
		a.t += dt
		local r = S.runs[a.run]
		if r == nil then
			continue
		end
		local k = a.kind
		if k == "still" then
			continue
		elseif k == "fire" then
			show(a, a.run, math.floor(a.t / r.dur) + 1)
		elseif k == "blink" then
			local cyc = a.t % 4.2
			show(a, a.run, if cyc > 4.0 then 2 else 1)
		elseif k == "cheer" then
			-- a burst of cheering, then a rest
			local cyc = a.t % 4
			show(a, a.run, if cyc < 1.6 then math.floor(cyc / r.dur) + 1 else 1)
		elseif k == "walk" then
			if a.wait > 0 then
				a.wait -= dt
				show(a, if a.dir < 0 then a.left else a.right, 1)
			else
				a.x += a.dir * a.speed * dt
				if (a.dir > 0 and a.x >= a.x1) or (a.dir < 0 and a.x <= a.x0) then
					a.x = math.clamp(a.x, a.x0, a.x1)
					a.dir = -a.dir
					a.wait = 1.2 + walkRng:NextNumber() * 1.6
				end
				show(a, if a.dir < 0 then a.left else a.right, math.floor(a.t / r.dur) + 1)
			end
		elseif k == "follow" then
			local ld = a.leader
			if ld then
				local want = ld.x - ld.dir * a.gap
				local d = want - a.x
				if math.abs(d) > 0.5 then
					local dir = if d > 0 then 1 else -1
					a.x += dir * math.min(math.abs(d), (ld.speed + 4) * dt)
					show(a, if dir < 0 then a.left else a.right, math.floor(a.t / r.dur) + 1)
				else
					show(a, if ld.dir < 0 then a.left else a.right, 1)
				end
			end
		elseif k == "gull" then
			a.x += a.speed * dt
			if a.x > L.W + 12 then
				a.x = -12
			elseif a.x < -12 then
				a.x = L.W + 12
			end
			a.y = a.baseY + math.sin(a.t * 0.9 + a.phase) * 3
			show(a, a.run, math.floor(a.t / r.dur) + 1)
		elseif k == "star" then
			local cyc = a.t % a.phase
			show(a, a.run, if cyc < r.dur * r.n then math.floor(cyc / r.dur) + 1 else 1)
		elseif k == "ember" then
			local life = 1.6
			local u = (a.t % life) / life
			a.y = a.baseY - u * 14
			a.x = a.x0 + math.sin(a.t * 2 + a.phase) * 3
			show(a, a.run, math.min(r.n, math.floor(u * r.n) + 1))
		end
	end
end

------------------------------------------------------------------ building the card
local function setBar(f: number)
	local L = S.L
	local fill = S.fill
	if L == nil or fill == nil then
		return
	end
	local inner = L.barW
	local w = math.clamp(math.floor(inner * f + 0.5), 0, inner)
	fill.Size = UDim2.fromOffset(w, 3)
	fill.Visible = w > 0
	local hi = S.fillHi
	if hi then
		hi.Size = UDim2.fromOffset(w, 1)
		hi.Visible = w > 0
	end
end

local function setStatus()
	local L, layer = S.L, S.layer
	local text = if S.mode == "cover" then S.coverStatus or STATUS.start else STATUS[S.phase] or STATUS.start
	if L == nil or layer == nil or S.statusShown == text then
		return
	end
	S.statusShown = text
	local old = S.statusLabel
	if old then
		old:Destroy()
	end
	if S.fallback then
		return
	end
	local im, r = centredText(layer, L, text, L.statusY, false, "shadow", C.status, C.ink, nil, 902)
	S.statusLabel = im
	-- three dots after it, lit one after another
	for k, d in S.dots do
		d.Position = UDim2.fromOffset(r.x1 + 1 + (k - 1) * 3, L.statusY + 6)
	end
end

local function setTip()
	local L, layer = S.L, S.layer
	if L == nil or layer == nil or S.fallback then
		return
	end
	local old = S.tipLabel
	if old then
		old:Destroy()
	end
	local plate = S.tipPlate
	if plate then
		plate:Destroy()
	end
	local text = TIPS[S.tipIndex]
	local im, r = centredText(layer, L, text, L.tipY + 3, false, "shadow", C.text, C.ink, nil, 902)
	S.tipLabel = im
	local p = rect(layer, r.x0 - 5, L.tipY, r.x1 - r.x0 + 10, 13, C.ink, 901, "TipPlate")
	p.BackgroundTransparency = 0.3
	S.tipPlate = p
end

------------------------------------------------------------------ the bank of cloud (the expansion's cover)

-- The bank for a canvas of W x H: three layers of domes over one another (each dome row of its own sizes), and domes
-- hanging under the front one. Sizes in px of a 360 px tall canvas, scaled to H. The same every time (a fixed seed).
local function bandShapes(W: number, H: number): Band
	local u = math.max(0.5, H / 360)
	local function sz(n: number): number
		return math.max(2, math.floor(n * u + 0.5))
	end
	local rng = Random.new(11)
	local b0 = domes(W, rng, sz(16), sz(32), 0.62)
	local b1 = domes(W, rng, sz(13), sz(26), 0.6)
	local b2 = domes(W, rng, sz(11), sz(22), 0.58)
	local hang = domes(W, rng, sz(10), sz(20), 0.32)
	local R1, R2, B = sz(24), sz(48), sz(76)
	local top: { number }, l1: { number }, l2: { number }, bot: { number } = table.create(W, 0), table.create(W, 0), table.create(W, 0), table.create(W, 0)
	local minTop, maxBot = 0, 0
	for i = 1, W do
		top[i] = -b0[i]
		l1[i] = R1 - b1[i]
		l2[i] = R2 - b2[i]
		bot[i] = B + hang[i]
		minTop = math.min(minTop, top[i])
		maxBot = math.max(maxBot, bot[i])
	end
	return { top = top, l1 = l1, l2 = l2, bot = bot, minTop = minTop, maxBot = maxBot, base0 = H - minTop, base1 = -maxBot - 1 }
end

-- The bank's top line at time `now`: from under the screen to over it, quick in the middle and easing at each end.
local function bankBase(cv: Cover, now: number): number
	local band = S.band
	if band == nil then
		return 0
	end
	local dur = if cv.state == "closing" then CLOSE_SEC else OPEN_SEC
	local p = math.clamp((now - cv.t0) / dur, 0, 1)
	local e = p * p * (3 - 2 * p)
	return math.floor(band.base0 + (band.base1 - band.base0) * e + 0.5)
end

-- The painting as the bank leaves it: the rows the bank crossed since the last time (all of them when `full`), each
-- pixel the card's (under the bank while it closes, over it while it opens), one of the bank's three flat colours, or
-- nothing (the game shows through). Only those rows are written to the image.
local function drawBand(full: boolean?)
	local cv, band, L = S.cover, S.band, S.L
	if cv == nil or band == nil or L == nil then
		return
	end
	local W, H = L.W, L.H
	local base = cv.base
	local lo, hi = base + band.minTop, base + band.maxBot
	local plo, phi = cv.lo or lo, cv.hi or hi
	cv.lo, cv.hi = lo, hi
	local img, paint = S.paintImg, S.paintBuf
	if img == nil or paint == nil or cv.state == "held" then
		return
	end
	local y0, y1 = math.min(lo, plo), math.max(hi, phi)
	if full then
		y0, y1 = 0, H - 1
	end
	y0, y1 = math.max(0, y0), math.min(H - 1, y1)
	if y1 < y0 then
		return
	end
	local over = cv.state == "opening" -- the card over the bank (it goes); else under it (it comes)
	local rows = y1 - y0 + 1
	local out = buffer.create(W * rows * 4)
	local top, l1, l2, bot = band.top, band.l1, band.l2, band.bot
	local cFar, cMid, cNear = px(BANK[1]), px(BANK[2]), px(BANK[3])
	local rowBytes = W * 4
	for y = y0, y1 do
		local rel = y - base
		local o = (y - y0) * rowBytes
		local src = y * rowBytes
		if rel < band.minTop then
			if over then
				buffer.copy(out, o, paint, src, rowBytes)
			end
		elseif rel >= band.maxBot then
			if not over then
				buffer.copy(out, o, paint, src, rowBytes)
			end
		else
			for x = 1, W do
				local q = o + (x - 1) * 4
				if rel < top[x] then
					if over then
						buffer.writeu32(out, q, buffer.readu32(paint, src + (x - 1) * 4))
					end
				elseif rel < l1[x] then
					buffer.writeu32(out, q, cFar)
				elseif rel < l2[x] then
					buffer.writeu32(out, q, cMid)
				elseif rel < bot[x] then
					buffer.writeu32(out, q, cNear)
				elseif not over then
					buffer.writeu32(out, q, buffer.readu32(paint, src + (x - 1) * 4))
				end
			end
		end
	end
	pcall(function()
		img:WritePixelsBuffer(Vector2.new(0, y0), Vector2.new(W, rows), out)
	end)
end

-- The card's sprites and words show only in the rows the card wholly covers: under the bank's lowest row while it
-- closes, over its highest while it opens, everywhere otherwise.
local function placeClip()
	local clip, layer, L = S.clip, S.layer, S.L
	if clip == nil or layer == nil or L == nil then
		return
	end
	local y0, y1 = 0, L.H
	local cv, band = S.cover, S.band
	if cv and band and cv.state == "closing" then
		y0 = math.clamp(cv.base + band.maxBot + 1, 0, L.H)
	elseif cv and band and cv.state == "opening" then
		y1 = math.clamp(cv.base + band.minTop, 0, L.H)
	end
	clip.Position = UDim2.fromOffset(0, y0)
	clip.Size = UDim2.fromOffset(L.W, y1 - y0)
	layer.Position = UDim2.fromOffset(0, -y0)
end

-- Everything laid out from the canvas's size: the painting, the scene, the words, the bar.
local function build()
	local root, canvas = S.root, S.canvas
	if root == nil or canvas == nil then
		return
	end
	local vp = viewport()
	S.K = pixelK(vp)
	local W, H = math.max(1, math.ceil(vp.X / S.K)), math.max(1, math.ceil(vp.Y / S.K))
	local L = layoutFor(W, H)
	S.L = L
	local sc = S.scaler
	if sc then
		sc.Scale = S.K
	end
	canvas.Size = UDim2.fromOffset(W, H)
	local old = canvas:FindFirstChild("Scene")
	if old then
		old:Destroy()
	end
	table.clear(S.actors)
	S.statusLabel, S.tipLabel, S.tipPlate, S.statusShown = nil, nil, nil, ""
	S.isleLabel = nil
	-- the painting, then over it a clip (all of the canvas but while a cover comes or goes) holding the rest: the
	-- sprites, the words and the bar
	local scene = Instance.new("Frame")
	scene.Name = "Scene"
	scene.BackgroundTransparency = 1
	scene.Size = UDim2.fromScale(1, 1)
	scene.Parent = canvas
	local clip = Instance.new("Frame")
	clip.Name = "Clip"
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Size = UDim2.fromOffset(W, H)
	clip.ZIndex = 3
	clip.Parent = scene
	local layer = Instance.new("Frame")
	layer.Name = "Over"
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromOffset(W, H)
	layer.Parent = clip
	S.layer, S.clip = layer, clip
	S.paintImg = nil
	if S.mode == "cover" then
		S.band = bandShapes(W, H)
	end
	if not S.fallback then
		local img, content = newImage(W, H)
		if img then
			local key = W .. "x" .. H
			if S.paintBuf == nil or S.paintKey ~= key then
				S.paintBuf, S.paintKey = paint(L), key
			end
			local buf = S.paintBuf :: buffer
			local cv = S.cover
			local ok
			if cv and cv.state ~= "held" then
				-- (a cover coming or going: the painting as the bank leaves it now)
				S.paintImg = img
				cv.base, cv.lo, cv.hi = bankBase(cv, os.clock()), nil, nil
				drawBand(true)
				ok = true
			else
				ok = pcall(function()
					(img :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(W, H), buf)
				end)
			end
			if ok then
				local bg = imageLabel(scene, content, 2)
				bg.Name = "Painting"
				bg.Size = UDim2.fromOffset(W, H)
				S.paintImg = img
				S.painted = true
			end
		end
		-- the floating island over it, its own image so that it can bob (under the sprites, which bob with it)
		if S.painted then
			if S.isleBuf == nil or S.isleKey ~= S.paintKey then
				local ib, ix, iy, iw, ih = paintIsle(L)
				S.isleBuf, S.isleBox, S.isleKey = ib, { ix, iy, iw, ih }, S.paintKey
			end
			local box = S.isleBox
			local iimg, icontent = newImage(box[3], box[4])
			if iimg and pcall(function()
				(iimg :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(box[3], box[4]), S.isleBuf :: buffer)
			end) then
				local il = imageLabel(layer, icontent, 3)
				il.Name = "Isle"
				il.Size = UDim2.fromOffset(box[3], box[4])
				S.isleX, S.isleY = box[1], box[2]
				il.Position = UDim2.fromOffset(box[1], box[2] + S.bob)
				S.isleLabel, S.isleShown = il, true
			end
		end
		if not S.painted then
			S.fallback = true
		end
	end
	if S.fallback then
		-- the plain card: the sky, the sea of clouds, the island's grass top over its stones
		rect(layer, 0, 0, W, L.horizon, SKY[5], 2, "Sky")
		rect(layer, 0, L.horizon, W, H - L.horizon, CLOUDS[3], 2, "Clouds")
		rect(layer, L.cx - math.floor(L.rx * 0.6), L.cy + L.ry - 2, 2 * math.floor(L.rx * 0.6), L.depth, STONE[3], 3, "Stones")
		rect(layer, L.cx - L.rx, L.cy - L.ry, 2 * L.rx, 2 * L.ry, GRASS, 4, "Island")
		local t = Instance.new("TextLabel")
		t.Name = "Title"
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, 16)
		t.Position = UDim2.fromOffset(0, L.titleY)
		t.Font = Enum.Font.Arcade
		t.TextSize = 16
		t.TextColor3 = rgb(C.accent)
		t.Text = if S.mode == "cover" and S.coverTitle then S.coverTitle else "Driftling Isle"
		t.ZIndex = 902
		t.Parent = layer
		S.title = { x0 = 0, y0 = L.titleY, x1 = W, y1 = L.titleY + 16 }
	else
		local _, r = centredText(layer, L, if S.mode == "cover" and S.coverTitle then S.coverTitle else "Driftling Isle", L.titleY, true, "title", C.accent, C.title_ink, C.title_aa, 902)
		S.title = r
		if S.atlasContent then
			placeScene(L)
		end
	end
	-- the bar in its frame of planks: its outline, the frame's light top and dark foot, the track, the fill with its light
	-- top
	local bx = L.cx - math.floor(L.barW / 2)
	rect(layer, bx - 3, L.barY - 3, L.barW + 6, 9, C.bar_ink, 900, "BarInk")
	rect(layer, bx - 2, L.barY - 2, L.barW + 4, 7, C.frame, 900, "BarFrame")
	rect(layer, bx - 2, L.barY - 2, L.barW + 4, 1, C.frame_hi, 900, "BarFrameHi")
	rect(layer, bx - 2, L.barY + 4, L.barW + 4, 1, C.frame_lo, 900, "BarFrameLo")
	rect(layer, bx, L.barY, L.barW, 3, C.plate, 901, "BarTrack")
	S.fill = rect(layer, bx, L.barY, 0, 3, C.accent, 902, "BarFill")
	S.fillHi = rect(layer, bx, L.barY, 0, 1, C.accent_hi, 903, "BarFillHi")
	setBar(S.bar)
	S.dots = {}
	for k = 1, 3 do
		table.insert(S.dots, rect(layer, 0, 0, 1, 1, C.status, 902, "Dot" .. k))
	end
	setStatus()
	setTip()
	step(0)
	placeClip()
end

------------------------------------------------------------------ the fade and the end
local function fadeTo(a: number)
	local root = S.root
	if root == nil then
		return
	end
	for _, d in root:GetDescendants() do
		if d:IsA("ImageLabel") then
			local base = d:GetAttribute("BaseT")
			if base == nil then
				base = d.ImageTransparency
				d:SetAttribute("BaseT", base)
			end
			d.ImageTransparency = 1 - (1 - (base :: number)) * (1 - a)
		elseif d:IsA("TextLabel") then
			d.TextTransparency = a
		elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then
			local base = d:GetAttribute("BaseT")
			if base == nil then
				base = d.BackgroundTransparency
				d:SetAttribute("BaseT", base)
			end
			d.BackgroundTransparency = 1 - (1 - (base :: number)) * (1 - a)
		end
	end
	root.BackgroundTransparency = a
end

local function destroy()
	local conn = S.conn
	if conn then
		conn:Disconnect()
	end
	local rc = S.resizeConn
	if rc then
		rc:Disconnect()
	end
	local gui = S.gui
	if gui then
		gui:Destroy()
	end
	pcall(function()
		GuiService.TouchControlsEnabled = true
	end)
	for _, img in S.images do
		pcall(function()
			img:Destroy()
		end)
	end
	table.clear(S.images)
	table.clear(S.actors)
	S.up = false
	S.gui, S.root, S.canvas, S.layer, S.clip, S.paintImg = nil, nil, nil, nil, nil, nil
	S.cover = nil
	S.atlas, S.atlasContent = nil, nil
end

------------------------------------------------------------------ the API
-- The card on the screen (the join's or a cover's: S.mode says which).
local function mount()
	local player = Players.LocalPlayer
	if player == nil then
		return
	end
	local pg = player:WaitForChild("PlayerGui", 10)
	if pg == nil then
		return
	end
	S.up = true
	S.t0 = os.clock()
	local gui = Instance.new("ScreenGui")
	gui.Name = "LoadingCard"
	gui.DisplayOrder = ORDER
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BorderSizePixel = 0
	root.BackgroundColor3 = rgb(SKY[4])
	-- (a cover starts with the game showing: only the bank and the card under it cover it)
	root.BackgroundTransparency = if S.mode == "cover" then 1 else 0
	root.Size = UDim2.fromScale(1, 1)
	root.Active = true
	root.Parent = gui
	local canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.Parent = root
	local sc = Instance.new("UIScale")
	sc.Parent = canvas
	S.gui, S.root, S.canvas, S.scaler = gui, root, canvas, sc
	gui.Parent = pg
	-- (Roblox's touch buttons are hidden while the card is up: nothing to press yet, and the jump button sat on it)
	pcall(function()
		GuiService.TouchControlsEnabled = false
	end)
	-- the atlas (EditableImages may be off: the plain card then)
	local okA, made = pcall(buildAtlas)
	if not okA or not made then
		S.fallback = not (newImage(1, 1) ~= nil)
	end
	build()
	local cam = Workspace.CurrentCamera
	if cam then
		S.resizeConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			S.resizeAt = os.clock() + 0.15
		end)
	end
	S.conn = RunService.Heartbeat:Connect(function(dt: number)
		local now = os.clock()
		if S.resizeAt > 0 and now >= S.resizeAt then
			S.resizeAt = 0
			build()
		end
		-- a cover coming or going: the bank moves on (every frame, so it glides), and at its end the card is up, or gone
		local cv = S.cover
		if cv and (cv.state == "closing" or cv.state == "opening") then
			cv.base = bankBase(cv, now)
			drawBand()
			placeClip()
			if now - cv.t0 >= (if cv.state == "closing" then CLOSE_SEC else OPEN_SEC) then
				if cv.state == "closing" then
					cv.state = "held"
					cv.coveredAt = now
					placeClip()
					local fn = cv.onCovered
					if fn then
						task.spawn(fn)
					end
				else
					local fn = cv.onOpened
					destroy()
					if fn then
						task.spawn(fn)
					end
					return
				end
			end
		end
		-- the bar creeps toward the phase's share, and follows the picture's own progress in the last one (a cover's
		-- bar follows what the caller says)
		local cover = S.mode == "cover"
		local target = if S.finished then 1 elseif cover then S.progress elseif S.phase == "picture" then 0.45 + 0.55 * S.progress elseif S.phase == "island" then 0.4 else 0.25
		local creep = if cover or S.phase == "picture" or S.finished then 1 else math.min(1, (now - S.t0) / 6)
		local want = target * creep
		if want > S.bar then
			S.bar = math.min(want, S.bar + dt * (if S.finished then 2.5 elseif cover then 1.2 else 0.6))
			setBar(S.bar)
		end
		-- the dots after the status, lit one after another
		local lit = math.floor(now * 2.5) % 4
		for k, d in S.dots do
			d.Visible = k <= lit and not S.fallback
		end
		if now - S.tipAt > TIP_SEC then
			S.tipAt = now
			if S.tipAt > S.t0 + 0.5 then
				S.tipIndex = S.tipIndex % #TIPS + 1
				setTip()
			end
		end
		if now >= S.nextTick then
			S.nextTick = now + 1 / SCENE_FPS
			S.ticks += 1
			step(math.min(0.1, 1 / SCENE_FPS))
		end
		if not S.finished and now - S.t0 > (if cover then COVER_SAFETY else SAFETY_SEC) then
			LoadingCard.finish()
		end
	end)
	S.tipAt = os.clock()
	local cv = S.cover
	if cv then
		-- (the bank sets off once the card is built: building it is the slow part)
		cv.t0 = os.clock()
	end
end

function LoadingCard.show()
	if S.up or S.finished then
		return
	end
	S.mode = "join"
	mount()
end

-- The card over the game for a while (an expansion: the request of 2026-11-20, "make a transition for expansion, hiding
-- the game with a loading transition"): a bank of cloud drifts up the screen and leaves the card behind it, with
-- `title` over the sky (the join's "Driftling Isle" when nil) and `status` under it; `onCovered` runs once the card
-- covers the screen. progress(f) moves the bar, status(text) changes the words, finish() fills the bar and the bank
-- drifts up again, taking the card with it (after HOLD_MIN up at least); `onOpened` runs once it is gone. False (and
-- nothing happens) while the card is up already.
type CoverOpts = { title: string?, status: string?, onCovered: (() -> ())?, onOpened: (() -> ())? }
function LoadingCard.cover(opts: CoverOpts?): boolean
	if S.up then
		return false
	end
	local o: CoverOpts = opts or {} :: CoverOpts
	S.mode = "cover"
	S.finished, S.fading = false, false
	S.bar, S.progress = 0, 0
	S.painted, S.fallback = false, false
	S.coverTitle, S.coverStatus = o.title, o.status
	S.cover = { state = "closing", t0 = os.clock(), base = 0, lo = nil, hi = nil, coveredAt = 0, onCovered = o.onCovered, onOpened = o.onOpened }
	mount()
	return S.up
end

-- A cover's words under the title.
function LoadingCard.status(text: string)
	if S.mode == "cover" and S.coverStatus ~= text then
		S.coverStatus = text
		setStatus()
	end
end

function LoadingCard.phase(name: string)
	if STATUS[name] and not S.finished then
		S.phase = name
		setStatus()
	end
end

function LoadingCard.progress(f: number)
	S.progress = math.clamp(f, 0, 1)
end

function LoadingCard.finish()
	if S.finished then
		return
	end
	S.finished = true
	if not S.up then
		return
	end
	if S.mode == "cover" then
		task.spawn(function()
			-- up for HOLD_MIN at least once it covers the screen, the bar full, then the bank takes it away
			local t0 = os.clock()
			while S.up do
				local cv = S.cover
				if cv == nil or (cv.state == "held" and os.clock() - cv.coveredAt >= HOLD_MIN and (S.bar >= 0.999 or os.clock() - t0 > 0.6 + HOLD_MIN + CLOSE_SEC)) then
					break
				end
				task.wait()
			end
			local cv = S.cover
			if cv and cv.state == "held" then
				cv.state = "opening"
				cv.t0 = os.clock()
				cv.base, cv.lo, cv.hi = bankBase(cv, cv.t0), nil, nil
			end
		end)
		return
	end
	task.spawn(function()
		-- the bar fills, then the card fades into the picture in a few steps
		local t0 = os.clock()
		while S.bar < 0.999 and os.clock() - t0 < 0.6 do
			task.wait()
		end
		S.fading = true
		for k = 1, FADE_STEPS do
			fadeTo(k / FADE_STEPS)
			task.wait(FADE_SEC / FADE_STEPS)
		end
		destroy()
	end)
end

function LoadingCard.state(): { [string]: any }
	local L = S.L
	return {
		up = S.up,
		phase = S.phase,
		bar = S.bar,
		finished = S.finished,
		fading = S.fading,
		painted = S.painted,
		fallback = S.fallback,
		actors = #S.actors,
		ticks = S.ticks,
		K = S.K,
		size = if L then Vector2.new(L.W, L.H) else Vector2.zero,
		title = S.title,
		mode = S.mode,
		cover = if S.cover then (S.cover :: Cover).state else nil,
		covered = S.cover ~= nil and (S.cover :: Cover).state == "held",
		bank = if S.cover then (S.cover :: Cover).base else nil,
		clip = if S.clip then { y = (S.clip :: Frame).Position.Y.Offset, h = (S.clip :: Frame).Size.Y.Offset } else nil,
		status = S.statusShown,
		island = if L then { cx = L.cx, cy = L.cy, rx = L.rx, ry = L.ry, depth = L.depth } else nil,
		isle = if S.isleShown then { x0 = S.isleBox[1], y0 = S.isleBox[2], w = S.isleBox[3], h = S.isleBox[4] } else nil,
		bob = S.bob,
		bobMoves = S.bobMoves,
	}
end

return LoadingCard
