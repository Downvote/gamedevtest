--!strict
-- The interface's sprites (docs/ARCHITECTURE.md 10.9; GAME_DESIGN 2's pixel art rules): every sprite from UI/ArtData
-- (generated by scripts/gen_art.py: a 1 px ink outline, anti-aliased steps, shaded) drawn at its own size, one sprite
-- pixel = one UI px = one art pixel. There is no scale: a bigger or smaller thing is its own sprite ("icon_x" and
-- "mini_x"), so no pixel is ever drawn bigger than the grid's. A sprite is an EditableImage made once per
-- name and shown by any number of ImageLabels (Pixelated); where EditableImages are not available it is drawn from
-- runs of 1 px rects instead (the faint anti-aliasing pixels as translucent ones).
-- The build catalog's pictures, "thumb_<id>" (24 x 24, drawn from the pieces' models: tools/preview/thumbs.sh), are in
-- UI/ThumbData, and the cosmetics' pictures, "look_<id>" (24 x 24, drawn from the pieces' models:
-- tools/preview/cosmetic_thumbs.sh), in UI/CosmeticThumbData, both in ArtData's format; every function here finds them
-- by the prefix.
--   PixelSprites.has(name), size(name) -> (w, h)
--   PixelSprites.image(parent, name, pos?, z?) -> GuiObject
--   PixelSprites.anim(parent, names, pos?, z?) -> Anim: a stack of frames (and each frame's "_flash"): set(i),
--     flash(seconds), moveTo(x, y), the frame `f` to position or destroy
local ArtData = require(script.Parent.ArtData)
local ThumbData = require(script.Parent.ThumbData)
local CosmeticThumbData = require(script.Parent.CosmeticThumbData)
local ImageMemory = require(script.Parent.Parent.Pixel.ImageMemory)

local PixelSprites = {}

local CHARS = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!$%&*+-/:;<=>?@^_~"
local INDEX: { [string]: number } = {}
for i = 1, #CHARS do
	INDEX[string.sub(CHARS, i, i)] = i
end

local images: { [string]: EditableImage } = {}
local failed: { [string]: boolean } = {} -- no image for this sprite (the rects draw it)
local canImages: boolean? = nil

-- A sprite's data: a catalog picture's from ThumbData, a cosmetic's from CosmeticThumbData, any other's from ArtData.
local function dataOf(name: string): ArtData.SpriteData?
	if string.sub(name, 1, 6) == "thumb_" then
		return ThumbData[name]
	elseif string.sub(name, 1, 5) == "look_" then
		return CosmeticThumbData[name]
	end
	return ArtData[name]
end

function PixelSprites.has(name: string): boolean
	return dataOf(name) ~= nil
end

function PixelSprites.size(name: string): (number, number)
	local d = dataOf(name)
	if d == nil then
		return 0, 0
	end
	return d.w, d.h
end

local function color3(hex: number): Color3
	return Color3.fromRGB(math.floor(hex / 65536) % 256, math.floor(hex / 256) % 256, hex % 256)
end

-- The sprite's EditableImage (made once), or nil where none can be made.
local function imageOf(name: string, d: ArtData.SpriteData): EditableImage?
	local have = images[name]
	if have then
		return have
	elseif failed[name] then
		return nil
	end
	if canImages == false then
		return nil
	end
	local img = ImageMemory.create(d.w, d.h, "sprites")
	if img == nil then
		canImages = canImages or false
		failed[name] = true
		return nil
	end
	local px = buffer.create(d.w * d.h * 4)
	for i = 1, d.w * d.h do
		local ch = string.sub(d.px, i, i)
		local k = INDEX[ch]
		if k then
			local hex = d.pal[k]
			local o = (i - 1) * 4
			buffer.writeu8(px, o, math.floor(hex / 65536) % 256)
			buffer.writeu8(px, o + 1, math.floor(hex / 256) % 256)
			buffer.writeu8(px, o + 2, hex % 256)
			buffer.writeu8(px, o + 3, math.floor(d.alpha[k] * 255 + 0.5))
		end
	end
	local ok = pcall(function()
		img:WritePixelsBuffer(Vector2.zero, Vector2.new(d.w, d.h), px)
	end)
	if not ok then
		img:Destroy()
		failed[name] = true
		canImages = false
		return nil
	end
	canImages = true
	images[name] = img
	return img
end

-- The rect fallback: a run of same-coloured pixels on a row is one rect.
local function rects(d: ArtData.SpriteData, f: Frame, z: number)
	for y = 0, d.h - 1 do
		local x = 0
		while x < d.w do
			local ch = string.sub(d.px, y * d.w + x + 1, y * d.w + x + 1)
			local run = 1
			while x + run < d.w and string.sub(d.px, y * d.w + x + run + 1, y * d.w + x + run + 1) == ch do
				run += 1
			end
			local k = INDEX[ch]
			if k then
				local r = Instance.new("Frame")
				r.Name = "Px"
				r.BorderSizePixel = 0
				r.BackgroundColor3 = color3(d.pal[k])
				r.BackgroundTransparency = 1 - d.alpha[k]
				r.Size = UDim2.fromOffset(run, 1)
				r.Position = UDim2.fromOffset(x, y)
				r.ZIndex = z
				r.Parent = f
			end
			x += run
		end
	end
end

-- A sprite at its own size (pos: its top-left, whole UI px).
function PixelSprites.image(parent: Instance?, name: string, pos: UDim2?, z: number?): GuiObject
	local d = dataOf(name)
	local zz = z or 3
	if d == nil then
		local f = Instance.new("Frame")
		f.Name = "Sprite_" .. name
		f.BackgroundTransparency = 1
		f.Size = UDim2.fromOffset(1, 1)
		f.Position = pos or UDim2.new()
		f.Parent = parent
		return f
	end
	local img = imageOf(name, d)
	if img then
		local l = Instance.new("ImageLabel")
		l.Name = "Sprite_" .. name
		l.BackgroundTransparency = 1
		l.BorderSizePixel = 0
		l.Size = UDim2.fromOffset(d.w, d.h)
		l.Position = pos or UDim2.new()
		l.ZIndex = zz
		l.ResampleMode = Enum.ResamplerMode.Pixelated
		l.ImageContent = Content.fromObject(img)
		l.Parent = parent
		return l
	end
	local f = Instance.new("Frame")
	f.Name = "Sprite_" .. name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.fromOffset(d.w, d.h)
	f.Position = pos or UDim2.new()
	f.ZIndex = zz
	rects(d, f, zz)
	f.Parent = parent
	return f
end

export type Anim = {
	f: Frame,
	w: number,
	h: number,
	set: (i: number) -> (),
	flash: (seconds: number?) -> (),
	moveTo: (x: number, y: number) -> (),
}

-- A sprite with frames (names: one per frame, same size): set(i) shows frame i; flash() shows its white "_flash"
-- for a moment (a hit); moveTo puts it at whole UI px.
function PixelSprites.anim(parent: Instance?, names: { string }, pos: UDim2?, z: number?): Anim
	local w, h = PixelSprites.size(names[1])
	local f = Instance.new("Frame")
	f.Name = "Anim_" .. names[1]
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.fromOffset(w, h)
	f.Position = pos or UDim2.new()
	f.ZIndex = z or 3
	local frames: { GuiObject } = {}
	local flashes: { GuiObject? } = {}
	for i, n in names do
		local im = PixelSprites.image(f, n, UDim2.fromOffset(0, 0), z or 3)
		im.Visible = i == 1
		frames[i] = im
	end
	f.Parent = parent
	local cur = 1
	local flashUntil = 0
	local function show()
		local flashing = os.clock() < flashUntil
		for i, im in frames do
			im.Visible = i == cur and not flashing
		end
		for i, fl in flashes do
			if fl then
				fl.Visible = i == cur and flashing
			end
		end
	end
	local a: Anim
	a = {
		f = f,
		w = w,
		h = h,
		set = function(i: number)
			local n = (i - 1) % #frames + 1
			if n ~= cur then
				cur = n
				show()
			elseif os.clock() >= flashUntil then
				show()
			end
		end,
		flash = function(seconds: number?)
			if flashes[cur] == nil and PixelSprites.has(names[cur] .. "_flash") then
				local fl = PixelSprites.image(f, names[cur] .. "_flash", UDim2.fromOffset(0, 0), (z or 3) + 1)
				fl.Visible = false
				flashes[cur] = fl
			end
			flashUntil = os.clock() + (seconds or 0.1)
			show()
			task.delay((seconds or 0.1) + 0.01, function()
				if f.Parent then
					show()
				end
			end)
		end,
		moveTo = function(x: number, y: number)
			f.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
		end,
	}
	return a
end

return PixelSprites
