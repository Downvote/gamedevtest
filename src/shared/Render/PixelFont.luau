--!strict
--!native
-- The game's pixel font: glyph metrics, measuring, word wrap and rasterising text into pixel masks (OWNER: WP9;
-- client UI and Pixel/PixelText use it; pure, no Instances). The glyphs are PixelFontData (generated by
-- scripts/gen_pixelfont.py from the "Minecraft" TTF by Craftron Gaming; see that script for how they were made).
--
-- Faces
--   PixelFont.SMALL  the UI face: 8 px em (rows 0-6 above the baseline, row 7 the descender; 7 px caps, 5 px
--                    x-height), proportional, 1 px letter spacing. One font pixel is one art pixel: on a UIKit pixel
--                    canvas a glyph pixel is one UI px (K screen px). Line pitch = round(8 * LineHeight) (10 px at
--                    UIKit.LINE = 1.25). Accented capitals reach 3 px above the em, lowercase accents 1 px.
--   PixelFont.BIG    the small face doubled and smoothed on the 1 px grid: 16 px em (rows 0-13 above the baseline,
--                    14 px caps, 2 px strokes, 2 px letter spacing), every diagonal step and rounded corner a 1 px
--                    stair (scripts/gen_pixelfont.py build_big): big titles drawn 1:1, no 2 px block beside a 1 px
--                    outline.
--
-- Measuring and wrapping (every width is a pen advance in font px: the sum of the glyph advances, which include
-- each glyph's 1 px spacing, so a word measures like Press Start 2P's n * 8 did, trailing gap included)
--   PixelFont.width(text, face?) -> number          widest line ("\n" splits lines; no wrapping)
--   PixelFont.wrap(text, maxW, face?) -> { string } word wrap: "\n" starts a paragraph, words break at spaces
--       while the line's pen width stays <= maxW, a word wider than a line breaks between letters
--   PixelFont.lineCount(text, maxW, face?) -> number
--   PixelFont.clip(line, maxW, face?) -> string     one line cut to fit maxW with "..." (unchanged when it fits)
--   PixelFont.ellipsize(line, maxW, face?) -> string  the line ending in "...", cut as far as needed to fit
--   PixelFont.pitch(lineHeight?, face?) -> number   px from one line's em top to the next
-- Rasterising
--   PixelFont.mask(lines, opts?) -> Mask   the lines (already wrapped) as a 1-byte-per-pixel mask: 0 = clear,
--       n >= 1 = ink in colour n (1, or 1 + opts.colors[line][char], see lineColors). opts: face, align
--       ("Left" | "Center" | "Right", each line within the widest), pitch, tracking (extra px between letters).
--       The text block's em box is (0, 0) .. (mask.blockW, mask.blockH); the mask covers the ink rows too:
--       mask pixel (0, 0) is block pixel (mask.ox, mask.oy) (oy < 0 when accents reach above the em).
--   PixelFont.under(mask, style) -> Mask   the layer drawn under the face: "shadow" (the face 1 px right and down),
--       "weight" (1 px down; bold on paper), "outline" (1 px all round plus the drop shadow; bold over the world),
--       "title" (the outline and 2 px of depth under it; the big words)
--   PixelFont.smooth(face, under) -> Mask   the under layer with its anti-aliasing pixels as 2 (pixel-art AA: the
--       outline pixel in the elbow of each step where a stroke turns, a curve bends or a diagonal starts and ends; not
--       along a whole 1:1 diagonal, not in the square inside corner where two straight strokes meet). The big words
--       draw them in a hue-shifted tone between the face and the outline.
--   PixelFont.rich(text) -> (plain, colors, rgbs)   minimal RichText: <font color="#RRGGBB"> / rgb(r,g,b) runs (and
--       <b>, <i>, <br />), everything else is stripped; colors[i] is the colour index of plain's i-th character
--       (0 = the label's own colour), rgbs[n] the 0xRRGGBB of index n.
--   PixelFont.lineColors(lines, plain, colors) -> { { number } }   those colour indices for each wrapped line
--   PixelFont.graphemes(text) -> { string }   UTF-8 characters (bytes when the text is not valid UTF-8)
type FontData = {
	smallSpace: number,
	smallBox: { number },
	small: { [string]: { number } },
	smallAlias: { [string]: string },
	bigBox: { number },
	big: { [string]: { number } },
}
local Data: FontData = require(script.Parent.PixelFontData) :: any

export type Glyph = { w: number, adv: number, top: number, rows: { number } }
export type Face = {
	name: string,
	em: number,
	ascent: number,
	space: number,
	glyphs: { [string]: Glyph },
	alias: { [string]: string },
	box: Glyph,
}
export type Mask = {
	w: number,
	h: number,
	ox: number,
	oy: number,
	blockW: number,
	blockH: number,
	px: buffer,
}
export type MaskOpts = {
	face: Face?,
	align: string?,
	pitch: number?,
	tracking: number?,
	colors: { { number } }?,
}

local PixelFont = {}

local ELLIPSIS = "..."

local function smallFace(): Face
	local glyphs: { [string]: Glyph } = {}
	for ch, d in Data.small do
		local rows: { number } = {}
		for i = 3, #d do
			rows[i - 2] = d[i]
		end
		glyphs[ch] = { w = d[1], adv = d[1] + 1, top = d[2], rows = rows }
	end
	glyphs[" "] = { w = 0, adv = Data.smallSpace, top = 0, rows = {} }
	local b = Data.smallBox
	local boxRows: { number } = {}
	for i = 3, #b do
		boxRows[i - 2] = b[i]
	end
	return {
		name = "small",
		em = 8,
		ascent = 7,
		space = Data.smallSpace,
		glyphs = glyphs,
		alias = Data.smallAlias,
		box = { w = b[1], adv = b[1] + 1, top = b[2], rows = boxRows },
	}
end

local function bigFace(): Face
	local glyphs: { [string]: Glyph } = {}
	for ch, d in Data.big do
		local rows: { number } = {}
		for i = 3, #d do
			rows[i - 2] = d[i]
		end
		-- (2 px of letter spacing: the small face's 1 px doubled)
		glyphs[ch] = { w = d[1], adv = d[1] + 2, top = d[2], rows = rows }
	end
	local sp = glyphs[" "]
	local b = Data.bigBox
	local boxRows: { number } = {}
	for i = 3, #b do
		boxRows[i - 2] = b[i]
	end
	return {
		name = "big",
		em = 16,
		ascent = 14,
		space = if sp then sp.adv else 6,
		glyphs = glyphs,
		alias = Data.smallAlias,
		box = { w = b[1], adv = b[1] + 2, top = b[2], rows = boxRows },
	}
end

PixelFont.SMALL = smallFace()
PixelFont.BIG = bigFace()

------------------------------------------------------------------ characters

function PixelFont.graphemes(text: string): { string }
	local out: { string } = {}
	local ok = pcall(function()
		for _, cp in utf8.codes(text) do
			table.insert(out, utf8.char(cp))
		end
	end)
	if not ok then
		table.clear(out)
		for i = 1, #text do
			out[i] = string.sub(text, i, i)
		end
	end
	return out
end

function PixelFont.glyph(face: Face, ch: string): Glyph
	local g = face.glyphs[ch]
	if g then
		return g
	end
	local a = face.alias[ch]
	if a then
		local ga = face.glyphs[a]
		if ga then
			return ga
		end
	end
	if ch == "\t" then
		return face.glyphs[" "] or face.box
	end
	return face.box
end

function PixelFont.has(face: Face, ch: string): boolean
	return face.glyphs[ch] ~= nil or face.alias[ch] ~= nil
end

------------------------------------------------------------------ measuring

-- Pen width of a single line (no "\n" in it).
local function lineWidth(face: Face, line: string, tracking: number): number
	if line == "" then
		return 0
	end
	local w = 0
	if not string.find(line, "[\128-\255]") then
		for i = 1, #line do
			w += PixelFont.glyph(face, string.sub(line, i, i)).adv + tracking
		end
		return w
	end
	for _, ch in PixelFont.graphemes(line) do
		w += PixelFont.glyph(face, ch).adv + tracking
	end
	return w
end

local widthCache: { [string]: number } = {}
local widthCount = 0

function PixelFont.width(text: string, face: Face?): number
	local f = face or PixelFont.SMALL
	if f == PixelFont.SMALL then
		local hit = widthCache[text]
		if hit then
			return hit
		end
	end
	local w = 0
	if string.find(text, "\n", 1, true) then
		for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
			w = math.max(w, lineWidth(f, line, 0))
		end
	else
		w = lineWidth(f, text, 0)
	end
	if f == PixelFont.SMALL then
		if widthCount > 4000 then
			table.clear(widthCache)
			widthCount = 0
		end
		widthCache[text] = w
		widthCount += 1
	end
	return w
end

function PixelFont.pitch(lineHeight: number?, face: Face?): number
	local f = face or PixelFont.SMALL
	return math.max(1, math.floor(f.em * (lineHeight or 1.25) + 0.5))
end

-- Breaks one word wider than maxW between letters; returns the pieces (the last one may be short).
local function breakWord(face: Face, word: string, maxW: number): { string }
	local out: { string } = {}
	local cur, cw = "", 0
	for _, ch in PixelFont.graphemes(word) do
		local a = PixelFont.glyph(face, ch).adv
		if cur ~= "" and cw + a > maxW then
			table.insert(out, cur)
			cur, cw = "", 0
		end
		cur ..= ch
		cw += a
	end
	table.insert(out, cur)
	return out
end

function PixelFont.wrap(text: string, maxW: number, face: Face?): { string }
	local f = face or PixelFont.SMALL
	local out: { string } = {}
	local spaceW = PixelFont.glyph(f, " ").adv
	for para in string.gmatch(text .. "\n", "([^\n]*)\n") do
		if para == "" then
			table.insert(out, "")
			continue
		end
		local line, lineW, first = "", 0, true
		for word in string.gmatch(para .. " ", "([^ ]*) ") do
			local ww = lineWidth(f, word, 0)
			if first then
				line, lineW, first = word, ww, false
			elseif lineW + spaceW + ww <= maxW then
				line ..= " " .. word
				lineW += spaceW + ww
			else
				table.insert(out, line)
				line, lineW = word, ww
			end
			if lineW > maxW then
				local pieces = breakWord(f, line, maxW)
				for i = 1, #pieces - 1 do
					table.insert(out, pieces[i])
				end
				line = pieces[#pieces]
				lineW = lineWidth(f, line, 0)
			end
		end
		table.insert(out, line)
	end
	return out
end

function PixelFont.lineCount(text: string, maxW: number, face: Face?): number
	return math.max(1, #PixelFont.wrap(text, maxW, face))
end

function PixelFont.clip(line: string, maxW: number, face: Face?): string
	local f = face or PixelFont.SMALL
	if lineWidth(f, line, 0) <= maxW then
		return line
	end
	return PixelFont.ellipsize(line, maxW, f)
end

function PixelFont.ellipsize(line: string, maxW: number, face: Face?): string
	local f = face or PixelFont.SMALL
	local ell = lineWidth(f, ELLIPSIS, 0)
	local chars = PixelFont.graphemes(line)
	local w = 0
	local n = 0
	for i, ch in chars do
		local a = PixelFont.glyph(f, ch).adv
		if w + a + ell > maxW then
			break
		end
		w += a
		n = i
	end
	local kept = table.concat(chars, "", 1, n)
	kept = string.gsub(kept, "[%s%p]+$", "")
	return kept .. ELLIPSIS
end

------------------------------------------------------------------ rasterising

function PixelFont.mask(lines: { string }, opts: MaskOpts?): Mask
	local o: MaskOpts = opts or {}
	local f = o.face or PixelFont.SMALL
	local tracking = o.tracking or 0
	local pitch = o.pitch or PixelFont.pitch(nil, f)
	local align = o.align or "Left"
	local colors = o.colors
	local n = math.max(1, #lines)
	-- line widths and the ink rows they reach
	local widths: { number } = {}
	local chars: { { string } } = {}
	local blockW = 0
	local yMin, yMax = 0, (n - 1) * pitch + f.em
	for i = 1, n do
		local cs = PixelFont.graphemes(lines[i] or "")
		chars[i] = cs
		local w = 0
		for _, ch in cs do
			local g = PixelFont.glyph(f, ch)
			w += g.adv + tracking
			if #g.rows > 0 then
				local y0 = (i - 1) * pitch + g.top
				yMin = math.min(yMin, y0)
				yMax = math.max(yMax, y0 + #g.rows)
			end
		end
		widths[i] = w
		blockW = math.max(blockW, w)
	end
	local W = math.max(1, blockW)
	local H = math.max(1, yMax - yMin)
	local px = buffer.create(W * H)
	for i = 1, n do
		local x = 0
		if align == "Center" then
			x = (blockW - widths[i]) // 2
		elseif align == "Right" then
			x = blockW - widths[i]
		end
		local yb = (i - 1) * pitch - yMin
		local lc = if colors then colors[i] else nil
		for j, ch in chars[i] do
			local g = PixelFont.glyph(f, ch)
			local v = if lc then (lc[j] or 0) + 1 else 1
			local y0 = yb + g.top
			for r, bits in g.rows do
				if bits ~= 0 then
					local y = y0 + r - 1
					if y >= 0 and y < H then
						local rowBase = y * W
						local c = 0
						local b = bits
						while b ~= 0 do
							if b % 2 == 1 then
								local xx = x + c
								if xx >= 0 and xx < W then
									buffer.writeu8(px, rowBase + xx, v)
								end
							end
							b //= 2
							c += 1
						end
					end
				end
			end
			x += g.adv + tracking
		end
	end
	return { w = W, h = H, ox = 0, oy = yMin, blockW = blockW, blockH = (n - 1) * pitch + f.em, px = px }
end

function PixelFont.under(m: Mask, style: string): Mask
	local dx0, dy0, growX, growY = 0, 0, 1, 1
	local offsets: { { number } }
	if style == "outline" then
		offsets = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 }, { 1, 1 } }
		dx0, dy0, growX, growY = -1, -1, 2, 2
	elseif style == "title" then
		-- the outline pushed 2 px down as well: block letters with depth
		offsets = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 }, { -1, 1 }, { 1, 1 }, { -1, 2 }, { 1, 2 }, { 0, 2 }, { 0, 3 } }
		dx0, dy0, growX, growY = -1, -1, 2, 4
	elseif style == "weight" then
		offsets = { { 0, 1 } }
		growX = 0
	else
		offsets = { { 1, 1 } }
	end
	local W, H = m.w + growX, m.h + growY
	local px = buffer.create(W * H)
	local src = m.px
	for y = 0, m.h - 1 do
		for x = 0, m.w - 1 do
			if buffer.readu8(src, y * m.w + x) ~= 0 then
				for _, d in offsets do
					local xx, yy = x + d[1] - dx0, y + d[2] - dy0
					buffer.writeu8(px, yy * W + xx, 1)
				end
			end
		end
	end
	return { w = W, h = H, ox = m.ox + dx0, oy = m.oy + dy0, blockW = m.blockW, blockH = m.blockH, px = px }
end

function PixelFont.smooth(face: Mask, under: Mask): Mask
	local fw, fh, fpx = face.w, face.h, face.px
	local dx, dy = face.ox - under.ox, face.oy - under.oy
	local W, H = under.w, under.h
	local function ink(x: number, y: number): boolean
		local fx, fy = x - dx, y - dy
		return fx >= 0 and fy >= 0 and fx < fw and fy < fh and buffer.readu8(fpx, fy * fw + fx) ~= 0
	end
	-- the elbows: outline pixels (not under the face) with a face pixel beside and one above or below, unless both
	-- strokes run on past them (a square inside corner)
	local elbow = buffer.create(W * H)
	for y = 0, H - 1 do
		for x = 0, W - 1 do
			if buffer.readu8(under.px, y * W + x) ~= 0 and not ink(x, y) then
				for sx = -1, 1, 2 do
					for sy = -1, 1, 2 do
						if ink(x + sx, y) and ink(x, y + sy) and not (ink(x + sx, y - sy) and ink(x - sx, y + sy)) then
							buffer.writeu8(elbow, y * W + x, 1)
						end
					end
				end
			end
		end
	end
	local function at(x: number, y: number): boolean
		return x >= 0 and y >= 0 and x < W and y < H and buffer.readu8(elbow, y * W + x) ~= 0
	end
	local px = buffer.create(W * H)
	buffer.copy(px, 0, under.px, 0, W * H)
	for y = 0, H - 1 do
		for x = 0, W - 1 do
			-- (inside a run of elbows along a 1:1 diagonal the steps are even already: only its ends are smoothed)
			if at(x, y) and not ((at(x + 1, y + 1) and at(x - 1, y - 1)) or (at(x + 1, y - 1) and at(x - 1, y + 1))) then
				buffer.writeu8(px, y * W + x, 2)
			end
		end
	end
	return { w = W, h = H, ox = under.ox, oy = under.oy, blockW = under.blockW, blockH = under.blockH, px = px }
end

------------------------------------------------------------------ rich text (minimal)

local function hexColor(s: string): number?
	local h = string.match(s, "^#?(%x%x%x%x%x%x)$")
	if h then
		return tonumber(h, 16)
	end
	local r, g, b = string.match(s, "^rgb%(%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*%)$")
	if r and g and b then
		return math.clamp(tonumber(r) :: number, 0, 255) * 65536 + math.clamp(tonumber(g) :: number, 0, 255) * 256 + math.clamp(tonumber(b) :: number, 0, 255)
	end
	return nil
end

local ENTITIES: { [string]: string } = { lt = "<", gt = ">", amp = "&", quot = '"', apos = "'" }

function PixelFont.rich(text: string): (string, { number }, { number })
	local plain: { string } = {}
	local colors: { number } = {}
	local rgbs: { number } = {}
	local index: { [number]: number } = {}
	local stack: { number } = { 0 }
	local i = 1
	local len = #text
	local function put(s: string)
		for _, ch in PixelFont.graphemes(s) do
			table.insert(plain, ch)
			table.insert(colors, if ch == "\n" then 0 else stack[#stack])
		end
	end
	while i <= len do
		local lt = string.find(text, "<", i, true)
		if lt == nil then
			put(string.sub(text, i))
			break
		end
		if lt > i then
			put(string.sub(text, i, lt - 1))
		end
		local gt = string.find(text, ">", lt, true)
		if gt == nil then
			put(string.sub(text, lt))
			break
		end
		local tag = string.lower(string.sub(text, lt + 1, gt - 1))
		if string.match(tag, "^font") then
			local c = string.match(tag, "color%s*=%s*[\"']([^\"']+)[\"']")
			local rgb = if c then hexColor(c) else nil
			if rgb then
				local idx = index[rgb]
				if idx == nil then
					table.insert(rgbs, rgb)
					idx = #rgbs
					index[rgb] = idx
				end
				table.insert(stack, idx)
			else
				table.insert(stack, stack[#stack])
			end
		elseif tag == "/font" then
			if #stack > 1 then
				table.remove(stack)
			end
		elseif string.match(tag, "^br") then
			put("\n")
		end
		i = gt + 1
	end
	local s = table.concat(plain)
	s = string.gsub(s, "&(%a+);", function(e: string): string
		return ENTITIES[e] or ("&" .. e .. ";")
	end)
	if #PixelFont.graphemes(s) ~= #plain then
		-- an entity collapsed: colours by character no longer line up; fall back to the label's colour
		table.clear(colors)
		for _ = 1, #PixelFont.graphemes(s) do
			table.insert(colors, 0)
		end
	end
	return s, colors, rgbs
end

-- The colour index of every character of every wrapped line: wrapping only drops spaces and line breaks, so the
-- lines' other characters appear in `plain` in order (spaces carry no ink and get 0).
function PixelFont.lineColors(lines: { string }, plain: string, colors: { number }): { { number } }
	local src = PixelFont.graphemes(plain)
	local p = 1
	local out: { { number } } = {}
	for i, line in lines do
		local lc: { number } = {}
		for j, ch in PixelFont.graphemes(line) do
			if ch == " " then
				lc[j] = 0
			else
				while p <= #src and src[p] ~= ch do
					p += 1
				end
				lc[j] = colors[p] or 0
				p += 1
			end
		end
		out[i] = lc
	end
	return out
end

return PixelFont
