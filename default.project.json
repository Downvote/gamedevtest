{
  "name": "byte-size-studio",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/first",
        "PixelFont": { "$path": "src/shared/Render/PixelFont.luau" },
        "PixelFontData": { "$path": "src/shared/Render/PixelFontData.luau" }
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CharacterJumpHeight": 7.2,
        "CharacterUseJumpPower": false,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "RbxCharacterSounds": {
          "$path": "src/RbxCharacterSounds.client.luau"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}
